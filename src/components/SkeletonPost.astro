---
/**
 * SkeletonPost Component
 *
 * Skeleton loader para simular la carga de un post.
 * Muestra una estructura visual similar a un post real
 * con elementos animados que simulan el contenido.
 */
---

<article class="bg-white rounded-lg border border-gray-200 mb-4 animate-pulse">
    <!-- Header Skeleton -->
    <div class="p-4 flex items-start gap-3">
        <!-- Avatar -->
        <div class="w-12 h-12 rounded-full bg-gray-300"></div>

        <div class="flex-1">
            <!-- Name -->
            <div class="h-4 bg-gray-300 rounded w-32 mb-2"></div>
            <!-- Title -->
            <div class="h-3 bg-gray-200 rounded w-48 mb-1"></div>
            <!-- Timestamp -->
            <div class="h-3 bg-gray-200 rounded w-20"></div>
        </div>
    </div>

    <!-- Content Skeleton -->
    <div class="px-4 pb-3 space-y-2">
        <div class="h-3 bg-gray-200 rounded w-full"></div>
        <div class="h-3 bg-gray-200 rounded w-full"></div>
        <div class="h-3 bg-gray-200 rounded w-3/4"></div>
    </div>

    <!-- Image Placeholder (opcional) -->
    <div class="px-4 pb-3">
        <div class="w-full h-64 bg-gray-300 rounded-lg"></div>
    </div>

    <!-- Stats Skeleton -->
    <div
        class="px-4 py-2 flex items-center justify-between border-t border-gray-200"
    >
        <div class="h-3 bg-gray-200 rounded w-16"></div>
        <div class="h-3 bg-gray-200 rounded w-20"></div>
    </div>

    <!-- Actions Skeleton -->
    <div
        class="px-4 py-2 flex items-center justify-around border-t border-gray-200"
    >
        <div class="flex-1 flex items-center justify-center gap-2 py-2">
            <div class="w-6 h-6 bg-gray-200 rounded"></div>
            <div class="h-3 bg-gray-200 rounded w-12"></div>
        </div>
        <div class="flex-1 flex items-center justify-center gap-2 py-2">
            <div class="w-6 h-6 bg-gray-200 rounded"></div>
            <div class="h-3 bg-gray-200 rounded w-16"></div>
        </div>
        <div class="flex-1 flex items-center justify-center gap-2 py-2">
            <div class="w-6 h-6 bg-gray-200 rounded"></div>
            <div class="h-3 bg-gray-200 rounded w-12"></div>
        </div>
    </div>
</article>

<style>
    @keyframes pulse {
        0%,
        100% {
            opacity: 1;
        }
        50% {
            opacity: 0.5;
        }
    }

    .animate-pulse {
        animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    }
</style>
