---
import type { SavedJob } from "../types/index.js";

interface Props {
    savedJob: SavedJob;
}

const { savedJob } = Astro.props;
const { job, savedDate } = savedJob;

// Generate company logo using dicebear
const companyAvatar = `https://api.dicebear.com/7.x/initials/svg?seed=${encodeURIComponent(
    job.company.name,
)}`;

// Format location
const locationText = job.location.isRemote
    ? "Remote"
    : `${job.location.city}, ${job.location.state}`;
---

<article
    class="saved-job-item bg-white border border-gray-200 rounded-lg p-6 hover:shadow-md transition"
    data-job-id={savedJob.id}
>
    <div class="flex gap-4">
        <!-- Company Logo -->
        <a href={`/jobs/${job.id}`} class="flex-shrink-0">
            <img
                src={companyAvatar}
                alt={job.company.name}
                class="w-14 h-14 rounded border border-gray-200"
            />
        </a>

        <!-- Job Details -->
        <div class="flex-1 min-w-0">
            <a href={`/jobs/${job.id}`} class="block group">
                <h3
                    class="text-lg font-semibold text-gray-900 group-hover:text-blue-600 transition mb-1"
                >
                    {job.title}
                </h3>
            </a>

            {
                job.isActivelyHiring && (
                    <span class="inline-block bg-green-100 text-green-700 text-xs font-medium px-2 py-1 rounded mb-2">
                        Actively hiring
                    </span>
                )
            }

            <p class="text-gray-700 mb-1">{job.company.name}</p>
            <p class="text-gray-600 text-sm mb-3">{locationText}</p>

            <p class="text-gray-500 text-sm">Saved {savedDate}</p>
        </div>

        <!-- Delete Button -->
        <button
            class="delete-saved-job flex-shrink-0 self-start p-2 text-gray-500 hover:text-red-600 hover:bg-red-50 rounded-full transition"
            aria-label="Remove saved job"
        >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path
                    d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"
                ></path>
            </svg>
        </button>
    </div>
</article>

<script>
    // Delete functionality
    document.querySelectorAll(".delete-saved-job").forEach((button) => {
        button.addEventListener("click", (e) => {
            const article = (e.currentTarget as HTMLElement).closest(
                ".saved-job-item",
            ) as HTMLElement;
            if (article) {
                article.style.transition = "opacity 0.3s, transform 0.3s";
                article.style.opacity = "0";
                article.style.transform = "translateX(20px)";

                setTimeout(() => {
                    article.remove();
                }, 300);
            }
        });
    });
</script>
