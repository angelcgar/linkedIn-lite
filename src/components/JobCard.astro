---
import type { Job } from "../types/index";

interface Props {
    job: Job;
}

const { job } = Astro.props;

const locationDisplay = job.location.isRemote
    ? `${job.location.city}, ${job.location.state} (Remote)`
    : `${job.location.city}, ${job.location.state}`;

const salaryDisplay = job.salary
    ? `$${(job.salary.min / 1000).toFixed(0)}K - $${(job.salary.max / 1000).toFixed(0)}K`
    : null;
---

<a
    href={`/jobs/${job.id}`}
    class="block bg-white rounded-lg shadow-sm hover:shadow-md transition p-4 border border-gray-100"
>
    <div class="flex gap-4">
        <!-- Company Logo -->
        <div class="flex-shrink-0">
            <img
                src={job.company.logo}
                alt={job.company.name}
                class="w-14 h-14 rounded-lg"
            />
        </div>

        <!-- Job Details -->
        <div class="flex-1 min-w-0">
            <div class="flex items-start justify-between gap-2 mb-1">
                <h3 class="font-semibold text-gray-900 text-lg">
                    {job.title}
                </h3>
                <button
                    class="flex-shrink-0 p-2 hover:bg-gray-100 rounded-lg transition -mt-1"
                    onclick="event.preventDefault(); event.stopPropagation();"
                    aria-label="Save job"
                >
                    <svg
                        class="w-6 h-6 text-gray-500"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"
                        ></path>
                    </svg>
                </button>
            </div>

            <p class="text-gray-700 mb-2">{job.company.name}</p>

            <div class="flex items-center text-sm text-gray-600 mb-3">
                <svg
                    class="w-4 h-4 mr-1"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                    ></path>
                </svg>
                <span>{locationDisplay}</span>
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2 mb-3">
                {
                    job.isActivelyHiring && (
                        <span class="px-3 py-1 bg-green-50 text-green-700 text-xs font-medium rounded-full">
                            ACTIVELY HIRING
                        </span>
                    )
                }
                {
                    job.type === "Full-time" && (
                        <span class="px-3 py-1 bg-blue-50 text-blue-700 text-xs font-medium rounded-full">
                            FULL-TIME
                        </span>
                    )
                }
                {
                    job.location.isRemote && (
                        <span class="px-3 py-1 bg-gray-100 text-gray-700 text-xs font-medium rounded-full">
                            REMOTE
                        </span>
                    )
                }
                {
                    salaryDisplay && (
                        <span class="px-3 py-1 bg-purple-50 text-purple-700 text-xs font-medium rounded-full">
                            {salaryDisplay}
                        </span>
                    )
                }
                {
                    job.experienceLevel === "Entry level" && (
                        <span class="px-3 py-1 bg-gray-100 text-gray-700 text-xs font-medium rounded-full">
                            ENTRY LEVEL
                        </span>
                    )
                }
            </div>

            <!-- Footer -->
            <p class="text-sm text-gray-500">
                {job.postedDate}
            </p>
        </div>
    </div>
</a>
