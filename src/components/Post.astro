---
import type { Post, User, PostWithAuthor } from "../types/index.js";

interface Props {
    post?: Post;
    author?: User;
    postWithAuthor?: PostWithAuthor;
}

const { post: postProp, author: authorProp, postWithAuthor } = Astro.props;

// Soportar ambos formatos: separado (post + author) o combinado (postWithAuthor)
const post = postProp || postWithAuthor?.post;
const author = authorProp || postWithAuthor?.author;

if (!post || !author) {
    throw new Error(
        "Post component requires either (post + author) or postWithAuthor",
    );
}
---

<article class="bg-white rounded-lg border border-gray-200 mb-4">
    <!-- Post Header -->
    <div class="p-4 flex items-start justify-between">
        <div class="flex items-start gap-3">
            <img
                src={author.avatar}
                alt={author.name}
                class="w-12 h-12 rounded-full"
            />
            <div>
                <h3 class="font-semibold text-gray-900">{author.name}</h3>
                <p class="text-xs text-gray-600">{author.title}</p>
                <p class="text-xs text-gray-500 mt-0.5">{post.timestamp}</p>
            </div>
        </div>
        <button
            class="text-gray-600 hover:bg-gray-100 rounded-full p-2 transition"
        >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path
                    d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"
                ></path>
            </svg>
        </button>
    </div>

    <!-- Post Content -->
    <div class="px-4 pb-3">
        <p class="text-gray-900 text-sm leading-relaxed">{post.content}</p>
    </div>

    <!-- Post Image (if exists) -->
    {
        post.image && (
            <div class="px-4 pb-3">
                <img
                    src={post.image}
                    alt="Post content"
                    class="w-full rounded-lg"
                />
            </div>
        )
    }

    <!-- Engagement Stats -->
    <div
        class="px-4 py-2 flex items-center justify-between text-xs text-gray-600 border-t border-gray-200"
    >
        <button class="hover:underline">
            {post.likes} Likes
        </button>
        <button class="hover:underline">
            {post.comments} Comments
        </button>
    </div>

    <!-- Action Buttons -->
    <div
        class="px-4 py-2 flex items-center justify-around border-t border-gray-200"
    >
        <button
            class="post-like-btn flex-1 flex items-center justify-center gap-2 py-2 text-gray-600 hover:bg-gray-50 rounded transition"
            data-post-id={post.id}
            data-likes={post.likes}
        >
            <svg
                class="like-icon w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5"
                ></path>
            </svg>
            <span class="like-text text-sm font-semibold">Like</span>
        </button>
        <button
            class="flex-1 flex items-center justify-center gap-2 py-2 text-gray-600 hover:bg-gray-50 rounded transition"
        >
            <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                ></path>
            </svg>
            <span class="text-sm font-semibold">Comment</span>
        </button>
        <button
            class="flex-1 flex items-center justify-center gap-2 py-2 text-gray-600 hover:bg-gray-50 rounded transition"
        >
            <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"
                ></path>
            </svg>
            <span class="text-sm font-semibold">Share</span>
        </button>
    </div>
</article>

<script>
    // Client-side interactivity for Like button
    document.addEventListener("DOMContentLoaded", () => {
        const likeButtons = document.querySelectorAll(".post-like-btn");

        likeButtons.forEach((button) => {
            const btn = button as HTMLButtonElement;
            let isLiked = false;
            let likeCount = parseInt(btn.dataset.likes || "0");

            btn.addEventListener("click", () => {
                isLiked = !isLiked;
                const icon = btn.querySelector(".like-icon") as SVGElement;
                const text = btn.querySelector(".like-text") as HTMLSpanElement;

                if (isLiked) {
                    likeCount++;
                    icon.setAttribute("fill", "currentColor");
                    btn.classList.add("text-blue-600");
                    btn.classList.remove("text-gray-600");
                } else {
                    likeCount--;
                    icon.setAttribute("fill", "none");
                    btn.classList.remove("text-blue-600");
                    btn.classList.add("text-gray-600");
                }

                // Update the like count in the stats section
                const postArticle = btn.closest("article");
                const likesStat = postArticle?.querySelector(
                    'button[class*="hover:underline"]',
                );
                if (likesStat) {
                    likesStat.textContent = `${likeCount} Likes`;
                }
            });
        });
    });
</script>
