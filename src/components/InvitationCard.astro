---
import type { Invitation } from "../types/index";

interface Props {
    invitation: Invitation;
}

const { invitation } = Astro.props;
---

<div class="bg-white rounded-lg p-4 flex items-center gap-4">
    <!-- Avatar -->
    <img
        src={invitation.user.avatar}
        alt={invitation.user.name}
        class="w-16 h-16 rounded-full flex-shrink-0"
    />

    <!-- User Info -->
    <div class="flex-1 min-w-0">
        <h3 class="font-semibold text-gray-900 text-lg mb-1">
            {invitation.user.name}
        </h3>
        <p class="text-gray-700 text-sm mb-2">
            {invitation.user.title}
        </p>
        {
            invitation.mutualConnections && (
                <p class="text-gray-600 text-sm">
                    {invitation.mutualConnections} mutual connections
                </p>
            )
        }
        {
            invitation.sharedGroup && (
                <p class="text-gray-600 text-sm">
                    Shared group: {invitation.sharedGroup}
                </p>
            )
        }
    </div>

    <!-- Action Buttons -->
    <div class="flex flex-col gap-2 flex-shrink-0">
        <button
            class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-full transition"
            data-invitation-id={invitation.id}
            data-action="accept"
        >
            Accept
        </button>
        <button
            class="px-6 py-2 border border-gray-300 hover:border-gray-400 text-gray-700 font-semibold rounded-full transition"
            data-invitation-id={invitation.id}
            data-action="ignore"
        >
            Ignore
        </button>
    </div>
</div>

<script>
    document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const button = target.closest("[data-action]") as HTMLButtonElement;

        if (!button) return;

        const action = button.dataset.action;
        const invitationId = button.dataset.invitationId;
        const card = button.closest(".bg-white") as HTMLElement;

        if (action === "accept") {
            console.log(`Accepted invitation: ${invitationId}`);
            card?.remove();
        } else if (action === "ignore") {
            console.log(`Ignored invitation: ${invitationId}`);
            card?.remove();
        }
    });
</script>
