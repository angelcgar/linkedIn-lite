---
import Layout from "../../layouts/Layout.astro";
import JobCard from "../../components/JobCard.astro";
import { getJobs } from "../../lib/api/index.js";

// Obtener parámetros de filtro desde URL
const searchQuery = Astro.url.searchParams.get("query") || "";
const locationQuery = Astro.url.searchParams.get("location") || "";
const isRemote = Astro.url.searchParams.get("remote") === "true";
const jobType = Astro.url.searchParams.get("type") || "";
const experienceLevel = Astro.url.searchParams.get("level") || "";

// Aplicar filtros
const jobs = await getJobs({
    query: searchQuery,
    location: locationQuery,
    isRemote: isRemote || undefined,
    type: jobType,
    experienceLevel: experienceLevel,
});

// Verificar si hay filtros activos
const hasActiveFilters =
    searchQuery || locationQuery || isRemote || jobType || experienceLevel;
---

<Layout>
    <div class="min-h-screen bg-gray-50">
        <!-- Header -->
        <header class="bg-white border-b border-gray-200 sticky top-0 z-40">
            <div class="max-w-5xl mx-auto px-4 py-4">
                <!-- Search Bar -->
                <form method="get" action="/jobs" id="jobs-search-form">
                    <div class="flex gap-3 mb-4">
                        <div class="relative flex-1">
                            <svg
                                class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 pointer-events-none"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                                ></path>
                            </svg>
                            <input
                                type="text"
                                name="query"
                                value={searchQuery}
                                placeholder="Job title, keyword..."
                                class="w-full bg-gray-50 border border-gray-300 rounded-lg pl-10 pr-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                            />
                        </div>

                        <div class="relative flex-1">
                            <svg
                                class="w-5 h-5 absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 pointer-events-none"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                                ></path>
                            </svg>
                            <input
                                type="text"
                                name="location"
                                value={locationQuery}
                                placeholder="Location"
                                class="w-full bg-gray-50 border border-gray-300 rounded-lg pl-10 pr-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                            />
                        </div>

                        <!-- Hidden inputs para mantener filtros -->
                        <input
                            type="hidden"
                            name="remote"
                            id="remote-input"
                            value={isRemote ? "true" : ""}
                        />
                        <input
                            type="hidden"
                            name="type"
                            id="type-input"
                            value={jobType}
                        />
                        <input
                            type="hidden"
                            name="level"
                            id="level-input"
                            value={experienceLevel}
                        />

                        <!-- Filters Dropdown Button -->
                        <div class="relative">
                            <button
                                type="button"
                                id="filters-dropdown-btn"
                                class="bg-blue-50 hover:bg-blue-100 rounded-lg p-3 transition flex-shrink-0 relative"
                            >
                                <svg
                                    class="w-6 h-6 text-blue-600"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"
                                    ></path>
                                </svg>
                                {
                                    hasActiveFilters && (
                                        <span class="absolute -top-1 -right-1 w-4 h-4 bg-red-500 rounded-full text-white text-xs flex items-center justify-center font-bold">
                                            !
                                        </span>
                                    )
                                }
                            </button>

                            <!-- Dropdown Menu -->
                            <div
                                id="filters-dropdown"
                                class="hidden absolute right-0 mt-2 w-72 bg-white rounded-lg shadow-lg border border-gray-200 py-2 z-50"
                            >
                                <!-- Remote -->
                                <div
                                    class="px-4 py-3 hover:bg-gray-50 cursor-pointer"
                                >
                                    <label
                                        class="flex items-center gap-3 cursor-pointer"
                                    >
                                        <input
                                            type="checkbox"
                                            id="remote-checkbox"
                                            checked={isRemote}
                                            class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-2 focus:ring-blue-500"
                                        />
                                        <div class="flex-1">
                                            <div
                                                class="text-sm font-medium text-gray-900"
                                            >
                                                Remote
                                            </div>
                                            <div class="text-xs text-gray-500">
                                                Work from anywhere
                                            </div>
                                        </div>
                                    </label>
                                </div>

                                <div class="border-t border-gray-200 my-1">
                                </div>

                                <!-- Job Type -->
                                <div class="px-4 py-2">
                                    <div
                                        class="text-xs font-semibold text-gray-500 uppercase mb-2"
                                    >
                                        Job Type
                                    </div>
                                    <div class="space-y-2">
                                        <label
                                            class="flex items-center gap-2 cursor-pointer"
                                        >
                                            <input
                                                type="radio"
                                                name="type-radio"
                                                value="Full-time"
                                                checked={jobType ===
                                                    "Full-time"}
                                                class="w-4 h-4 text-blue-600 border-gray-300 focus:ring-2 focus:ring-blue-500"
                                            />
                                            <span class="text-sm text-gray-700"
                                                >Full-time</span
                                            >
                                        </label>
                                        <label
                                            class="flex items-center gap-2 cursor-pointer"
                                        >
                                            <input
                                                type="radio"
                                                name="type-radio"
                                                value="Part-time"
                                                checked={jobType ===
                                                    "Part-time"}
                                                class="w-4 h-4 text-blue-600 border-gray-300 focus:ring-2 focus:ring-blue-500"
                                            />
                                            <span class="text-sm text-gray-700"
                                                >Part-time</span
                                            >
                                        </label>
                                        <label
                                            class="flex items-center gap-2 cursor-pointer"
                                        >
                                            <input
                                                type="radio"
                                                name="type-radio"
                                                value="Contract"
                                                checked={jobType === "Contract"}
                                                class="w-4 h-4 text-blue-600 border-gray-300 focus:ring-2 focus:ring-blue-500"
                                            />
                                            <span class="text-sm text-gray-700"
                                                >Contract</span
                                            >
                                        </label>
                                    </div>
                                </div>

                                <div class="border-t border-gray-200 my-1">
                                </div>

                                <!-- Experience Level -->
                                <div class="px-4 py-2">
                                    <div
                                        class="text-xs font-semibold text-gray-500 uppercase mb-2"
                                    >
                                        Experience Level
                                    </div>
                                    <div class="space-y-2">
                                        <label
                                            class="flex items-center gap-2 cursor-pointer"
                                        >
                                            <input
                                                type="radio"
                                                name="level-radio"
                                                value="Entry level"
                                                checked={experienceLevel ===
                                                    "Entry level"}
                                                class="w-4 h-4 text-blue-600 border-gray-300 focus:ring-2 focus:ring-blue-500"
                                            />
                                            <span class="text-sm text-gray-700"
                                                >Entry level</span
                                            >
                                        </label>
                                        <label
                                            class="flex items-center gap-2 cursor-pointer"
                                        >
                                            <input
                                                type="radio"
                                                name="level-radio"
                                                value="Mid-Senior level"
                                                checked={experienceLevel ===
                                                    "Mid-Senior level"}
                                                class="w-4 h-4 text-blue-600 border-gray-300 focus:ring-2 focus:ring-blue-500"
                                            />
                                            <span class="text-sm text-gray-700"
                                                >Mid-Senior level</span
                                            >
                                        </label>
                                        <label
                                            class="flex items-center gap-2 cursor-pointer"
                                        >
                                            <input
                                                type="radio"
                                                name="level-radio"
                                                value="Director"
                                                checked={experienceLevel ===
                                                    "Director"}
                                                class="w-4 h-4 text-blue-600 border-gray-300 focus:ring-2 focus:ring-blue-500"
                                            />
                                            <span class="text-sm text-gray-700"
                                                >Director</span
                                            >
                                        </label>
                                    </div>
                                </div>

                                <div class="border-t border-gray-200 my-1">
                                </div>

                                <!-- Action Buttons -->
                                <div class="px-4 py-3 flex gap-2">
                                    <button
                                        type="button"
                                        id="clear-filters-btn"
                                        class="flex-1 px-4 py-2 text-sm border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition font-medium"
                                    >
                                        Clear filters
                                    </button>
                                    <button
                                        type="submit"
                                        class="flex-1 px-4 py-2 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium"
                                    >
                                        Apply
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <!-- Active Filters Pills -->
                {
                    hasActiveFilters && (
                        <div class="flex gap-2 flex-wrap">
                            {isRemote && (
                                <span class="inline-flex items-center gap-2 px-3 py-1 bg-blue-100 text-blue-700 text-sm font-medium rounded-full">
                                    Remote
                                    <a
                                        href={`/jobs?query=${searchQuery}&location=${locationQuery}&type=${jobType}&level=${experienceLevel}`}
                                        class="hover:bg-blue-200 rounded-full p-0.5"
                                    >
                                        <svg
                                            class="w-3 h-3"
                                            fill="currentColor"
                                            viewBox="0 0 20 20"
                                        >
                                            <path
                                                fill-rule="evenodd"
                                                d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                                                clip-rule="evenodd"
                                            />
                                        </svg>
                                    </a>
                                </span>
                            )}
                            {jobType && (
                                <span class="inline-flex items-center gap-2 px-3 py-1 bg-blue-100 text-blue-700 text-sm font-medium rounded-full">
                                    {jobType}
                                    <a
                                        href={`/jobs?query=${searchQuery}&location=${locationQuery}&remote=${isRemote}&level=${experienceLevel}`}
                                        class="hover:bg-blue-200 rounded-full p-0.5"
                                    >
                                        <svg
                                            class="w-3 h-3"
                                            fill="currentColor"
                                            viewBox="0 0 20 20"
                                        >
                                            <path
                                                fill-rule="evenodd"
                                                d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                                                clip-rule="evenodd"
                                            />
                                        </svg>
                                    </a>
                                </span>
                            )}
                            {experienceLevel && (
                                <span class="inline-flex items-center gap-2 px-3 py-1 bg-blue-100 text-blue-700 text-sm font-medium rounded-full">
                                    {experienceLevel}
                                    <a
                                        href={`/jobs?query=${searchQuery}&location=${locationQuery}&remote=${isRemote}&type=${jobType}`}
                                        class="hover:bg-blue-200 rounded-full p-0.5"
                                    >
                                        <svg
                                            class="w-3 h-3"
                                            fill="currentColor"
                                            viewBox="0 0 20 20"
                                        >
                                            <path
                                                fill-rule="evenodd"
                                                d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                                                clip-rule="evenodd"
                                            />
                                        </svg>
                                    </a>
                                </span>
                            )}
                            <a
                                href="/jobs"
                                class="inline-flex items-center gap-1 px-3 py-1 text-blue-600 text-sm font-medium hover:underline"
                            >
                                Clear all
                            </a>
                        </div>
                    )
                }
            </div>
        </header>

        <main class="max-w-5xl mx-auto px-4 py-6 pb-24">
            <!-- Section Header -->
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-2xl font-bold text-gray-900">
                    Recommended for you
                </h2>
                <a
                    href="#"
                    class="text-blue-600 font-semibold text-sm hover:underline"
                >
                    See all
                </a>
            </div>

            <!-- Jobs Grid -->
            <div class="space-y-4">
                {jobs.map((job) => <JobCard job={job} />)}
            </div>

            {
                jobs.length === 0 && (
                    <div class="text-center py-12">
                        <p class="text-gray-500">
                            No jobs found matching your criteria.
                        </p>
                    </div>
                )
            }
        </main>

        <!-- Bottom Navigation -->
        <nav
            class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 px-6 py-2"
        >
            <div class="max-w-5xl mx-auto flex items-center justify-around">
                <a
                    href="/"
                    class="flex flex-col items-center py-2 text-gray-600 hover:text-gray-900 transition"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"></path>
                    </svg>
                    <span class="text-xs mt-1">Home</span>
                </a>
                <a
                    href="/network"
                    class="flex flex-col items-center py-2 text-gray-600 hover:text-gray-900 transition"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                        ></path>
                    </svg>
                    <span class="text-xs mt-1">Network</span>
                </a>
                <button class="flex flex-col items-center py-2 -mt-6">
                    <div
                        class="w-14 h-14 bg-blue-600 rounded-full flex items-center justify-center shadow-lg"
                    >
                        <svg
                            class="w-8 h-8 text-white"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                            ></path>
                        </svg>
                    </div>
                </button>
                <a
                    href="/jobs"
                    class="flex flex-col items-center py-2 text-blue-600"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"
                        ></path>
                    </svg>
                    <span class="text-xs mt-1">Jobs</span>
                </a>
                <a
                    href="/settings"
                    class="flex flex-col items-center py-2 text-gray-600 hover:text-gray-900 transition"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                        ></path>
                    </svg>
                    <span class="text-xs mt-1">Settings</span>
                </a>
            </div>
        </nav>
    </div>
</Layout>

<script>
    // Toggle del dropdown de filtros (similar al de Settings en Navbar)
    const filtersBtn = document.getElementById("filters-dropdown-btn");
    const filtersDropdown = document.getElementById("filters-dropdown");

    filtersBtn?.addEventListener("click", (e) => {
        e.stopPropagation();
        filtersDropdown?.classList.toggle("hidden");
    });

    // Cerrar dropdown al hacer click fuera
    document.addEventListener("click", () => {
        filtersDropdown?.classList.add("hidden");
    });

    // Prevenir que clicks dentro del dropdown lo cierren
    filtersDropdown?.addEventListener("click", (e) => {
        e.stopPropagation();
    });

    // Sincronizar checkbox de Remote con input hidden
    const remoteCheckbox = document.getElementById(
        "remote-checkbox",
    ) as HTMLInputElement;
    const remoteInput = document.getElementById(
        "remote-input",
    ) as HTMLInputElement;

    remoteCheckbox?.addEventListener("change", () => {
        remoteInput.value = remoteCheckbox.checked ? "true" : "";
    });

    // Sincronizar radio buttons de Job Type con input hidden
    const typeRadios = document.querySelectorAll('input[name="type-radio"]');
    const typeInput = document.getElementById("type-input") as HTMLInputElement;

    typeRadios.forEach((radio) => {
        radio.addEventListener("change", (e) => {
            const target = e.target as HTMLInputElement;
            typeInput.value = target.checked ? target.value : "";
        });
    });

    // Sincronizar radio buttons de Experience Level con input hidden
    const levelRadios = document.querySelectorAll('input[name="level-radio"]');
    const levelInput = document.getElementById(
        "level-input",
    ) as HTMLInputElement;

    levelRadios.forEach((radio) => {
        radio.addEventListener("change", (e) => {
            const target = e.target as HTMLInputElement;
            levelInput.value = target.checked ? target.value : "";
        });
    });

    // Botón Clear filters
    const clearFiltersBtn = document.getElementById("clear-filters-btn");
    const searchForm = document.getElementById(
        "jobs-search-form",
    ) as HTMLFormElement;

    clearFiltersBtn?.addEventListener("click", () => {
        // Limpiar todos los inputs
        remoteInput.value = "";
        typeInput.value = "";
        levelInput.value = "";

        // Desmarcar checkbox y radios
        if (remoteCheckbox) remoteCheckbox.checked = false;
        typeRadios.forEach((radio) => {
            (radio as HTMLInputElement).checked = false;
        });
        levelRadios.forEach((radio) => {
            (radio as HTMLInputElement).checked = false;
        });

        // Cerrar dropdown
        filtersDropdown?.classList.add("hidden");

        // Submit form con filtros limpiados
        searchForm?.submit();
    });
</script>

<style>
    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }
    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>
