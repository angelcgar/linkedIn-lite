---
import Layout from "../../layouts/Layout.astro";
import { getJobById } from "../../lib/api/index.js";

export const prerender = false;

const { id } = Astro.params;

if (!id) {
    return Astro.redirect("/jobs");
}

const job = await getJobById(id);

if (!job) {
    return Astro.redirect("/jobs");
}

const locationDisplay = job.location.isRemote
    ? `${job.location.city}, ${job.location.state} • Remote`
    : `${job.location.city}, ${job.location.state}`;

const salaryDisplay = job.salary
    ? `$${(job.salary.min / 1000).toFixed(0)}K - $${(job.salary.max / 1000).toFixed(0)}K`
    : null;
---

<Layout>
    <div class="min-h-screen bg-gray-50 pb-24">
        <!-- Header -->
        <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
            <div
                class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between"
            >
                <a
                    href="/jobs"
                    class="p-2 hover:bg-gray-100 rounded-full transition -ml-2"
                >
                    <svg
                        class="w-6 h-6 text-gray-700"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"
                        ></path>
                    </svg>
                </a>

                <button
                    class="p-2 hover:bg-gray-100 rounded-full transition"
                    aria-label="Share"
                >
                    <svg
                        class="w-6 h-6 text-gray-700"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z"
                        ></path>
                    </svg>
                </button>
            </div>
        </header>

        <main class="max-w-5xl mx-auto px-4 py-6">
            <!-- Company & Title Section -->
            <div class="bg-white rounded-lg shadow-sm p-6 mb-4">
                <div class="flex gap-4 mb-4">
                    <img
                        src={job.company.logo}
                        alt={job.company.name}
                        class="w-16 h-16 rounded-lg flex-shrink-0"
                    />
                    <div class="flex-1 min-w-0">
                        <h1 class="text-2xl font-bold text-gray-900 mb-1">
                            {job.title}
                        </h1>
                        <a
                            href="#"
                            class="text-blue-600 font-semibold hover:underline inline-block"
                        >
                            {job.company.name}
                        </a>
                    </div>
                </div>

                <div class="flex items-center text-gray-700 mb-4">
                    <svg
                        class="w-5 h-5 mr-2"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                        ></path>
                    </svg>
                    <span>{locationDisplay}</span>
                </div>

                <!-- Meta Info -->
                <div class="flex flex-wrap gap-4 text-sm text-gray-600 mb-4">
                    <div class="flex items-center gap-1">
                        <svg
                            class="w-5 h-5 text-blue-600"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8z"
                            ></path>
                            <path d="M12.5 7H11v6l5.25 3.15.75-1.23-4.5-2.67z"
                            ></path>
                        </svg>
                        <span>Posted {job.postedDate}</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <svg
                            class="w-5 h-5 text-blue-600"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                            ></path>
                        </svg>
                        <span>{job.applicants} applicants</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <svg
                            class="w-5 h-5 text-blue-600"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"
                            ></path>
                        </svg>
                        <span>{job.type}</span>
                    </div>
                </div>

                <!-- Save Button -->
                <button
                    class="flex items-center gap-2 px-4 py-2 border border-blue-600 text-blue-600 rounded-full hover:bg-blue-50 transition"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"
                        ></path>
                    </svg>
                    <span class="font-semibold">Save</span>
                </button>
            </div>

            <!-- Job Description -->
            <div class="bg-white rounded-lg shadow-sm p-6 mb-4">
                <h2 class="text-xl font-bold text-gray-900 mb-4">
                    Job Description
                </h2>
                <p class="text-gray-700 leading-relaxed whitespace-pre-line">
                    {job.description}
                </p>
            </div>

            <!-- Responsibilities -->
            <div class="bg-white rounded-lg shadow-sm p-6 mb-4">
                <h2 class="text-xl font-bold text-gray-900 mb-4">
                    Responsibilities
                </h2>
                <ul class="space-y-3">
                    {
                        job.responsibilities.map((item) => (
                            <li class="flex gap-3">
                                <svg
                                    class="w-6 h-6 text-blue-600 flex-shrink-0"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" />
                                </svg>
                                <span class="text-gray-700">{item}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- Requirements -->
            <div class="bg-white rounded-lg shadow-sm p-6 mb-4">
                <h2 class="text-xl font-bold text-gray-900 mb-4">
                    Requirements
                </h2>
                <ul class="space-y-3">
                    {
                        job.requirements.map((item) => (
                            <li class="flex gap-3">
                                <span class="text-gray-400 font-bold flex-shrink-0">
                                    •
                                </span>
                                <span class="text-gray-700">{item}</span>
                            </li>
                        ))
                    }
                </ul>
            </div>

            <!-- About the Company -->
            {
                job.company.description && (
                    <div class="bg-white rounded-lg shadow-sm p-6">
                        <div class="flex items-center gap-3 mb-4">
                            <svg
                                class="w-6 h-6 text-gray-700"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path d="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z" />
                            </svg>
                            <h2 class="text-xl font-bold text-gray-900">
                                About the Company
                            </h2>
                        </div>

                        <h3 class="font-bold text-gray-900 mb-1">
                            {job.company.name}
                        </h3>
                        <p class="text-sm text-gray-600 mb-3">
                            {job.company.size} • {job.company.industry}
                        </p>
                        <p class="text-gray-700 leading-relaxed">
                            {job.company.description}
                        </p>
                    </div>
                )
            }
        </main>

        <!-- Sticky Apply Button -->
        <div
            class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 px-4 py-4 shadow-lg"
        >
            <div class="max-w-5xl mx-auto flex gap-3">
                <a
                    href={`/jobs/apply/${id}`}
                    class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-4 rounded-lg transition text-center"
                >
                    Apply Now
                </a>
            </div>
        </div>
    </div>
</Layout>
