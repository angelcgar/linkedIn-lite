---
import Layout from "../../layouts/Layout.astro";
import MessageBubble from "../../components/MessageBubble.astro";
import {
    getMessagesByConversationId,
    getConversationById,
    getCurrentUser,
} from "../../lib/api/index.js";

export const prerender = false;

const { id } = Astro.params;

if (!id) {
    return Astro.redirect("/messages");
}

const conversationData = await getConversationById(id);
const currentUser = await getCurrentUser();

if (!conversationData || !currentUser) {
    return Astro.redirect("/messages");
}

const { conversation, otherUser } = conversationData;
const messages = await getMessagesByConversationId(id);
---

<Layout>
    <div class="min-h-screen bg-gray-50 flex flex-col">
        <!-- Header -->
        <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
            <div
                class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between"
            >
                <div class="flex items-center gap-3 flex-1">
                    <a
                        href="/messages"
                        class="p-2 hover:bg-gray-100 rounded-full transition"
                    >
                        <svg
                            class="w-6 h-6 text-gray-700"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"
                            ></path>
                        </svg>
                    </a>

                    <div class="relative flex-shrink-0">
                        <img
                            src={otherUser.avatar}
                            alt={otherUser.name}
                            class="w-10 h-10 rounded-full"
                        />
                        {
                            otherUser.isOnline && (
                                <span class="absolute bottom-0 right-0 w-3 h-3 bg-green-500 rounded-full border-2 border-white" />
                            )
                        }
                    </div>

                    <div class="min-w-0 flex-1">
                        <h1 class="font-semibold text-gray-900 truncate">
                            {otherUser.name}
                        </h1>
                        <p class="text-xs text-gray-600">
                            {
                                otherUser.isOnline
                                    ? "Active now"
                                    : otherUser.lastSeen
                            }
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <button
                        class="p-2 hover:bg-gray-100 rounded-full transition"
                    >
                        <svg
                            class="w-6 h-6 text-gray-700"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"
                            ></path>
                        </svg>
                    </button>
                    <button
                        class="p-2 hover:bg-gray-100 rounded-full transition"
                    >
                        <svg
                            class="w-6 h-6 text-gray-700"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"
                            ></path>
                        </svg>
                    </button>
                </div>
            </div>
        </header>

        <!-- Messages Area -->
        <main class="flex-1 max-w-5xl mx-auto w-full px-4 py-6 overflow-y-auto">
            <!-- Date Separator -->
            <div class="text-center mb-6">
                <span
                    class="text-xs text-gray-500 font-medium px-3 py-1 bg-white rounded-full border border-gray-200"
                >
                    TODAY
                </span>
            </div>

            <!-- Messages -->
            <div class="space-y-1">
                {
                    messages.map((message) => {
                        const isCurrentUser =
                            message.senderId === currentUser.id;
                        const sender = isCurrentUser ? currentUser : otherUser;

                        return (
                            <MessageBubble
                                message={message}
                                isCurrentUser={isCurrentUser}
                                sender={sender}
                            />
                        );
                    })
                }
            </div>
        </main>

        <!-- Message Input -->
        <div class="bg-white border-t border-gray-200 sticky bottom-0">
            <div class="max-w-5xl mx-auto px-4 py-3">
                <form class="flex items-center gap-3" id="message-form">
                    <button
                        type="button"
                        class="p-2 text-gray-600 hover:bg-gray-100 rounded-full transition"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                            ></path>
                        </svg>
                    </button>

                    <button
                        type="button"
                        class="p-2 text-gray-600 hover:bg-gray-100 rounded-full transition"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"
                            ></path>
                        </svg>
                    </button>

                    <input
                        type="text"
                        name="message"
                        placeholder="Write a message..."
                        class="flex-1 bg-gray-100 px-4 py-3 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                        autocomplete="off"
                    />

                    <button
                        type="submit"
                        class="p-3 bg-blue-600 hover:bg-blue-700 text-white rounded-full transition shadow-lg"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"
                            ></path>
                        </svg>
                    </button>
                </form>
            </div>
        </div>

        <!-- Bottom Navigation (hidden on mobile chat view) -->
        <nav
            class="hidden md:block fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 px-6 py-2"
        >
            <div class="max-w-5xl mx-auto flex items-center justify-around">
                <a
                    href="/"
                    class="flex flex-col items-center py-2 text-gray-600 hover:text-gray-900 transition"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"></path>
                    </svg>
                    <span class="text-xs mt-1">Home</span>
                </a>
                <a
                    href="/network"
                    class="flex flex-col items-center py-2 text-gray-600 hover:text-gray-900 transition"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                        ></path>
                    </svg>
                    <span class="text-xs mt-1">Network</span>
                </a>
                <button class="flex flex-col items-center py-2 -mt-6">
                    <div
                        class="w-14 h-14 bg-blue-600 rounded-full flex items-center justify-center shadow-lg"
                    >
                        <svg
                            class="w-8 h-8 text-white"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                            ></path>
                        </svg>
                    </div>
                </button>
                <a
                    href="/jobs"
                    class="flex flex-col items-center py-2 text-gray-600 hover:text-gray-900 transition"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"
                        ></path>
                    </svg>
                    <span class="text-xs mt-1">Jobs</span>
                </a>
                <a
                    href="/messages"
                    class="flex flex-col items-center py-2 text-blue-600"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-2 12H6v-2h12v2zm0-3H6V9h12v2zm0-3H6V6h12v2z"
                        ></path>
                    </svg>
                    <span class="text-xs mt-1">Messaging</span>
                </a>
            </div>
        </nav>
    </div>
</Layout>

<script>
    // Client-side message sending
    const form = document.getElementById("message-form") as HTMLFormElement;
    const messageInput = form?.querySelector(
        'input[name="message"]',
    ) as HTMLInputElement;

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        const content = messageInput.value.trim();
        if (!content) return;

        // In a real app, this would call the API
        // For now, we just clear the input (message will appear on page reload)
        messageInput.value = "";

        // TODO: Implement real-time message sending
        console.log("Message sent:", content);
    });
</script>
