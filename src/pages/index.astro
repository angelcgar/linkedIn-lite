---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import ProfileCard from "../components/ProfileCard.astro";
import ExperienceCard from "../components/ExperienceCard.astro";
import RightSidebar from "../components/RightSidebar.astro";
import CreatePostModal from "../components/CreatePostModal.astro";
import SkeletonPost from "../components/SkeletonPost.astro";

import {
	getCurrentUser,
	getUserSuggestions,
	getPosts,
} from "../lib/api/index.js";

/**
 * FEED PAGE (/)
 * Muestra el timeline principal de posts sin filtros de búsqueda.
 * Para búsqueda de posts, usar /search
 */

// Fetch data using API layer (simulated for now, ready for real backend)
const currentUser = await getCurrentUser();
const suggestions = await getUserSuggestions(3);
// Los posts se cargarán dinámicamente del lado del cliente
const users = (await import("../lib/data.js")).users;

// Handle case where current user is not found
if (!currentUser) {
	throw new Error("Current user not found");
}
---

<Layout>
	<Navbar />

	<main class="max-w-7xl mx-auto px-4 py-6">
		<div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6">
			<!-- Left Sidebar - Hidden on mobile, visible on desktop -->
			<div class="hidden lg:block lg:col-span-3 space-y-4">
				<ProfileCard user={currentUser} />
				<ExperienceCard />
			</div>

			<!-- Main Feed -->
			<div class="lg:col-span-6">
				<!-- Create Post Box -->
				<div
					class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-700 p-4 mb-4"
				>
					<div class="flex items-center gap-3">
						<img
							src={currentUser.avatar}
							alt={currentUser.name}
							class="w-12 h-12 rounded-full"
						/>
						<button
							id="open-create-post-modal"
							data-user={JSON.stringify(currentUser)}
							class="flex-1 text-left px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-full text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 transition"
						>
							Start a post
						</button>
					</div>
					<div
						class="flex items-center justify-around mt-3 pt-3 border-t border-gray-200 dark:border-gray-700"
					>
						<button
							id="open-create-post-modal-photo"
							class="flex items-center gap-2 px-4 py-2 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 rounded transition"
						>
							<svg
								class="w-5 h-5 text-blue-500"
								fill="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zM8.5 13.5l2.5 3.01L14.5 12l4.5 6H5l3.5-4.5z"
								></path>
							</svg>
							<span class="text-sm font-semibold">Photo</span>
						</button>
						<button
							id="open-create-post-modal-article"
							class="flex items-center gap-2 px-4 py-2 text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-gray-800 rounded transition"
						>
							<svg
								class="w-5 h-5 text-green-500"
								fill="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"
								></path>
							</svg>
							<span class="text-sm font-semibold">Article</span>
						</button>
					</div>
				</div>



				<!-- Posts Feed -->
				<div class="posts-feed">
					<!-- Skeleton loaders - se reemplazan cuando cargan los posts -->
					<div id="posts-loading-container">
						<SkeletonPost />
						<SkeletonPost />
						<SkeletonPost />
					</div>
					<div id="posts-container"></div>
				</div>
			</div>

			<!-- Right Sidebar - Hidden on mobile and tablet, visible on desktop -->
			<div class="hidden lg:block lg:col-span-3">
				<RightSidebar suggestions={suggestions} />
			</div>
		</div>
	</main>

	<!-- Create Post Modal -->
	<CreatePostModal currentUser={currentUser} />
</Layout>

<script>
	import { users } from "../lib/data";
	import { posts as postsData } from "../lib/data";
	import { initializePosts } from "../lib/feed/storageService.js";
	import { renderFeed } from "../lib/feed/feed.js";

	// Make users available globally for feed rendering
	window.__USERS_DATA__ = users;

	// Abrir modal desde los botones Photo y Article también
	const photoBtn = document.getElementById("open-create-post-modal-photo");
	const articleBtn = document.getElementById(
		"open-create-post-modal-article",
	);
	const openModalBtn = document.getElementById("open-create-post-modal");

	photoBtn?.addEventListener("click", () => {
		openModalBtn?.click();
	});

	articleBtn?.addEventListener("click", () => {
		openModalBtn?.click();
	});

	// Initialize posts and render feed
	const loadingContainer = document.getElementById("posts-loading-container");
	const sortSelect = document.getElementById("feed-sort-select");

	// Initialize localStorage with default posts
	initializePosts(postsData);

	// Initial render
	setTimeout(() => {
		renderFeed(users, 'recent');
		if (loadingContainer) {
			loadingContainer.style.display = "none";
		}
	}, 500);

	// Handle sort change
	sortSelect?.addEventListener("change", (e) => {
		const sortBy = e.target.value;
		renderFeed(users, sortBy);
	});
</script>
