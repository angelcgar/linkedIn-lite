---
import Layout from "../layouts/Layout.astro";
import SavedJobItem from "../components/SavedJobItem.astro";
import { getSavedJobs, getSavedPosts } from "../lib/api/index.js";

const savedJobs = await getSavedJobs();
const savedPosts = await getSavedPosts();
---

<Layout>
    <div class="min-h-screen bg-gray-50 pb-20">
        <!-- Header -->
        <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
            <div class="max-w-5xl mx-auto px-4 py-4 flex items-center gap-4">
                <a
                    href="/"
                    class="p-2 hover:bg-gray-100 rounded-full transition"
                >
                    <svg
                        class="w-6 h-6 text-gray-700"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"
                        ></path>
                    </svg>
                </a>

                <h1 class="text-xl font-semibold text-gray-900 flex-1">
                    Saved Items
                </h1>
            </div>
        </header>

        <main class="max-w-5xl mx-auto px-4 pt-4">
            <!-- Search Bar -->
            <div class="mb-6">
                <div class="relative">
                    <svg
                        class="absolute left-4 top-1/2 transform -translate-y-1/2 w-5 h-5 text-gray-400"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
                        ></path>
                    </svg>
                    <input
                        type="search"
                        placeholder="Search saved items..."
                        class="w-full bg-gray-100 border border-gray-200 rounded-lg pl-12 pr-4 py-3 text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    />
                </div>
            </div>

            <!-- Tabs -->
            <div class="mb-6 border-b border-gray-200">
                <div class="flex gap-8">
                    <button
                        class="tab-button pb-3 text-gray-900 border-b-2 border-blue-600 font-semibold"
                        data-tab="jobs"
                    >
                        Saved Jobs
                    </button>
                    <button
                        class="tab-button pb-3 text-gray-500 border-b-2 border-transparent hover:text-gray-900 transition"
                        data-tab="posts"
                    >
                        Saved Posts
                    </button>
                </div>
            </div>

            <!-- Saved Jobs Content -->
            <div id="jobs-content" class="tab-content">
                <div class="space-y-4">
                    {
                        savedJobs.map((savedJob) => (
                            <SavedJobItem savedJob={savedJob} />
                        ))
                    }
                </div>

                <!-- Empty State -->
                <div class="text-center py-12">
                    <p class="text-gray-600 mb-6">
                        You've reached the end of your saved jobs.
                    </p>
                    <a
                        href="/jobs"
                        class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-lg transition"
                    >
                        Find more jobs
                    </a>
                </div>
            </div>

            <!-- Saved Posts Content -->
            <div id="posts-content" class="tab-content hidden">
                <div class="space-y-4">
                    {
                        savedPosts.map((savedPost) => (
                            <article class="bg-white border border-gray-200 rounded-lg p-6">
                                <div class="flex gap-3 mb-4">
                                    <img
                                        src={savedPost.post.author.avatar}
                                        alt={savedPost.post.author.name}
                                        class="w-12 h-12 rounded-full"
                                    />
                                    <div class="flex-1">
                                        <h3 class="font-semibold text-gray-900">
                                            {savedPost.post.author.name}
                                        </h3>
                                        <p class="text-sm text-gray-600">
                                            {savedPost.post.author.title}
                                        </p>
                                        <p class="text-xs text-gray-500 mt-1">
                                            {savedPost.post.post.timestamp}
                                        </p>
                                    </div>
                                </div>

                                <p class="text-gray-800 mb-4 line-clamp-3">
                                    {savedPost.post.post.content}
                                </p>

                                <div class="flex items-center justify-between pt-4 border-t border-gray-200">
                                    <span class="text-sm text-gray-500">
                                        Saved {savedPost.savedDate}
                                    </span>
                                    <button class="text-gray-500 hover:text-red-600 transition">
                                        <svg
                                            class="w-5 h-5"
                                            fill="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" />
                                        </svg>
                                    </button>
                                </div>
                            </article>
                        ))
                    }
                </div>

                <!-- Empty State -->
                <div class="text-center py-12">
                    <p class="text-gray-600 mb-6">
                        You've reached the end of your saved posts.
                    </p>
                    <a
                        href="/"
                        class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-lg transition"
                    >
                        Browse more posts
                    </a>
                </div>
            </div>
        </main>
    </div>

    <script>
        // Tab switching functionality
        const tabButtons = document.querySelectorAll(".tab-button");
        const tabContents = document.querySelectorAll(".tab-content");

        tabButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const targetTab = button.getAttribute("data-tab");

                // Update button states
                tabButtons.forEach((btn) => {
                    if (btn.getAttribute("data-tab") === targetTab) {
                        btn.classList.remove(
                            "text-gray-500",
                            "border-transparent",
                        );
                        btn.classList.add(
                            "text-gray-900",
                            "border-blue-600",
                            "font-semibold",
                        );
                    } else {
                        btn.classList.remove(
                            "text-gray-900",
                            "border-blue-600",
                            "font-semibold",
                        );
                        btn.classList.add(
                            "text-gray-500",
                            "border-transparent",
                        );
                    }
                });

                // Update content visibility
                tabContents.forEach((content) => {
                    if (content.id === `${targetTab}-content`) {
                        content.classList.remove("hidden");
                    } else {
                        content.classList.add("hidden");
                    }
                });
            });
        });
    </script>
</Layout>
