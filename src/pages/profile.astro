---
import Layout from "../layouts/Layout.astro";
import { getCurrentUser } from "../lib/api/index.js";
import ExperienceItem from "../components/ExperienceItem.astro";
import SkillBadge from "../components/SkillBadge.astro";

const user = await getCurrentUser();

if (!user) {
    return Astro.redirect("/");
}
---

<Layout>
    <div class="min-h-screen bg-neutral-100">
        <!-- Header -->
        <header class="bg-white border-b border-gray-200">
            <div
                class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between"
            >
                <button
                    onclick="history.back()"
                    class="p-2 hover:bg-gray-100 rounded-full transition"
                >
                    <svg
                        class="w-6 h-6 text-gray-700"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"
                        ></path>
                    </svg>
                </button>
                <h1 class="text-lg font-semibold text-gray-900">{user.name}</h1>
                <button class="p-2 hover:bg-gray-100 rounded-full transition">
                    <svg
                        class="w-6 h-6 text-gray-700"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"
                        ></path>
                    </svg>
                </button>
            </div>
        </header>

        <main class="max-w-5xl mx-auto">
            <!-- Profile Header Card -->
            <div class="bg-white mb-2">
                <!-- Cover Image -->
                <div class="h-32 bg-gradient-to-r from-blue-500 to-blue-600">
                </div>

                <!-- Profile Info Section -->
                <div class="px-4 pb-4">
                    <!-- Avatar -->
                    <div class="relative -mt-16 mb-4">
                        <img
                            src={user.avatar}
                            alt={user.name}
                            class="w-32 h-32 rounded-full border-4 border-white"
                        />
                    </div>

                    <!-- Name & Title -->
                    <div class="mb-4">
                        <h1 class="text-2xl font-bold text-gray-900">
                            {user.name}
                        </h1>
                        <p class="text-base text-gray-900 mt-1">{user.title}</p>
                        <div
                            class="flex items-center gap-2 mt-2 text-sm text-gray-600"
                        >
                            {
                                user.location && (
                                    <div class="flex items-center gap-1">
                                        <svg
                                            class="w-4 h-4"
                                            fill="currentColor"
                                            viewBox="0 0 24 24"
                                        >
                                            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
                                        </svg>
                                        <span>{user.location}</span>
                                    </div>
                                )
                            }
                            <span>•</span>
                            <a
                                href="#"
                                class="text-blue-600 font-semibold hover:underline"
                            >
                                {user.connections}+ connections
                            </a>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex gap-2">
                        <button
                            class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-6 rounded-full transition"
                        >
                            Edit Profile
                        </button>
                        <button
                            class="px-6 py-2.5 border border-gray-300 text-gray-700 font-semibold rounded-full hover:bg-gray-50 transition"
                        >
                            Share
                        </button>
                        <button
                            class="px-4 py-2.5 border border-gray-300 text-gray-700 rounded-full hover:bg-gray-50 transition"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"
                                ></path>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            <!-- About Section -->
            {
                user.about && (
                    <div class="bg-white mb-2 p-6">
                        <h2 class="text-xl font-bold text-gray-900 mb-3">
                            About
                        </h2>
                        <p class="text-sm text-gray-900 leading-relaxed">
                            {user.about}
                        </p>
                    </div>
                )
            }

            <!-- Experience Section -->
            {
                user.experience && user.experience.length > 0 && (
                    <div class="bg-white mb-2 p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-xl font-bold text-gray-900">
                                Experience
                            </h2>
                            <button class="p-2 hover:bg-gray-100 rounded-full transition">
                                <svg
                                    class="w-6 h-6 text-gray-700"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" />
                                </svg>
                            </button>
                        </div>
                        <div class="divide-y divide-gray-200">
                            {user.experience.map((exp) => (
                                <ExperienceItem experience={exp} />
                            ))}
                        </div>
                    </div>
                )
            }

            <!-- Skills Section -->
            {
                user.skills && user.skills.length > 0 && (
                    <div class="bg-white mb-2 p-6">
                        <div class="flex items-center justify-between mb-4">
                            <h2 class="text-xl font-bold text-gray-900">
                                Skills
                            </h2>
                            <button class="p-2 hover:bg-gray-100 rounded-full transition">
                                <svg
                                    class="w-6 h-6 text-gray-700"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                                </svg>
                            </button>
                        </div>
                        <div class="flex flex-wrap gap-2">
                            {user.skills.map((skill) => (
                                <SkillBadge skill={skill} />
                            ))}
                        </div>
                    </div>
                )
            }

            <!-- Bottom Navigation -->
            <nav
                class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 px-6 py-2"
            >
                <div class="max-w-5xl mx-auto flex items-center justify-around">
                    <a
                        href="/"
                        class="flex flex-col items-center py-2 text-gray-600 hover:text-gray-900 transition"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"
                            ></path>
                        </svg>
                        <span class="text-xs mt-1">Home</span>
                    </a>
                    <a
                        href="/network"
                        class="flex flex-col items-center py-2 text-gray-600 hover:text-gray-900 transition"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                            ></path>
                        </svg>
                        <span class="text-xs mt-1">Network</span>
                    </a>
                    <button class="flex flex-col items-center py-2 -mt-6">
                        <div
                            class="w-14 h-14 bg-blue-600 rounded-full flex items-center justify-center shadow-lg"
                        >
                            <svg
                                class="w-8 h-8 text-white"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                                ></path>
                            </svg>
                        </div>
                    </button>
                    <a
                        href="/jobs"
                        class="flex flex-col items-center py-2 text-gray-600 hover:text-gray-900 transition"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"
                            ></path>
                        </svg>
                        <span class="text-xs mt-1">Jobs</span>
                    </a>
                    <a
                        href="/profile"
                        class="flex flex-col items-center py-2 text-blue-600"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"
                            ></path>
                        </svg>
                        <span class="text-xs mt-1">Profile</span>
                    </a>
                </div>
            </nav>
        </main>
    </div>
</Layout>
