---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout>
    <Navbar />

    <main class="max-w-4xl mx-auto px-4 py-12">
        <article class="bg-white rounded-lg shadow-sm p-8">
            <!-- Header -->
            <header class="mb-8 pb-6 border-b border-gray-200">
                <h1 class="text-4xl font-bold text-gray-900 mb-3">
                    Privacy Policy
                </h1>
                <p class="text-gray-600">Last updated: January 18, 2026</p>
            </header>

            <!-- Introduction -->
            <section class="mb-8">
                <p class="text-gray-700 leading-relaxed mb-4">
                    LinkedIn Lite ("we," "our," or "us") is a demo portfolio
                    project designed to showcase modern web development
                    practices. This Privacy Policy explains our approach to data
                    handling in this demonstration environment.
                </p>
                <div class="bg-blue-50 border-l-4 border-blue-500 p-4 rounded">
                    <p class="text-sm text-blue-900 font-medium">
                        Important: This is a demo application. No real user data
                        is collected, stored, or transmitted to any servers.
                    </p>
                </div>
            </section>

            <!-- What We Collect -->
            <section class="mb-8">
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">
                    Information Collection
                </h2>
                <p class="text-gray-700 leading-relaxed mb-4">
                    As a frontend-only demonstration project, LinkedIn Lite does
                    not collect, store, or process any real personal
                    information. All user interactions are:
                </p>
                <ul class="space-y-2 ml-6">
                    <li class="text-gray-700 flex items-start gap-2">
                        <span class="text-blue-600 mt-1">•</span>
                        <span
                            >Simulated with mock data stored locally in your
                            browser</span
                        >
                    </li>
                    <li class="text-gray-700 flex items-start gap-2">
                        <span class="text-blue-600 mt-1">•</span>
                        <span
                            >Not transmitted to any external servers or
                            databases</span
                        >
                    </li>
                    <li class="text-gray-700 flex items-start gap-2">
                        <span class="text-blue-600 mt-1">•</span>
                        <span>Cleared when you close your browser session</span>
                    </li>
                    <li class="text-gray-700 flex items-start gap-2">
                        <span class="text-blue-600 mt-1">•</span>
                        <span
                            >Never shared with third parties or used for any
                            purpose</span
                        >
                    </li>
                </ul>
            </section>

            <!-- How We Use Information -->
            <section class="mb-8">
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">
                    Local Data Storage
                </h2>
                <p class="text-gray-700 leading-relaxed mb-4">
                    The application may use browser local storage for
                    demonstration purposes, such as:
                </p>
                <div class="bg-gray-50 rounded-lg p-4 space-y-3">
                    <div>
                        <h3 class="font-semibold text-gray-900 mb-1">
                            Session State
                        </h3>
                        <p class="text-sm text-gray-600">
                            Maintaining UI state during your demo session
                            (temporary)
                        </p>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-900 mb-1">
                            Mock Interactions
                        </h3>
                        <p class="text-sm text-gray-600">
                            Simulating features like posts, messages, and
                            connections (not real data)
                        </p>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-900 mb-1">
                            User Preferences
                        </h3>
                        <p class="text-sm text-gray-600">
                            Storing demo preferences like theme or language
                            (optional)
                        </p>
                    </div>
                </div>
            </section>

            <!-- Data Security -->
            <section class="mb-8">
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">
                    Data Security
                </h2>
                <p class="text-gray-700 leading-relaxed mb-4">
                    Since this is a demonstration project with no backend
                    infrastructure:
                </p>
                <ul class="space-y-3">
                    <li class="flex items-start gap-3">
                        <svg
                            class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                clip-rule="evenodd"></path>
                        </svg>
                        <span class="text-gray-700"
                            >No user data is transmitted over networks</span
                        >
                    </li>
                    <li class="flex items-start gap-3">
                        <svg
                            class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                clip-rule="evenodd"></path>
                        </svg>
                        <span class="text-gray-700"
                            >All mock data is generated for demonstration only</span
                        >
                    </li>
                    <li class="flex items-start gap-3">
                        <svg
                            class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                clip-rule="evenodd"></path>
                        </svg>
                        <span class="text-gray-700"
                            >No authentication or account systems exist</span
                        >
                    </li>
                    <li class="flex items-start gap-3">
                        <svg
                            class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                clip-rule="evenodd"></path>
                        </svg>
                        <span class="text-gray-700"
                            >Source code is open for review</span
                        >
                    </li>
                </ul>
            </section>

            <!-- Third Party Services -->
            <section class="mb-8">
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">
                    Third-Party Services
                </h2>
                <p class="text-gray-700 leading-relaxed mb-4">
                    LinkedIn Lite may use the following external services for
                    demonstration purposes:
                </p>
                <ul class="space-y-2 ml-6">
                    <li class="text-gray-700">
                        <strong>Avatar Generation:</strong> DiceBear API for generating
                        placeholder avatars (public service, no personal data)
                    </li>
                    <li class="text-gray-700">
                        <strong>Images:</strong> Unsplash for stock photos (public
                        CDN, no tracking)
                    </li>
                </ul>
            </section>

            <!-- Your Rights -->
            <section class="mb-8">
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">
                    Your Control
                </h2>
                <p class="text-gray-700 leading-relaxed mb-4">
                    Since all data is local to your browser:
                </p>
                <ul class="space-y-2 ml-6">
                    <li class="text-gray-700 flex items-start gap-2">
                        <span class="text-blue-600 mt-1">•</span>
                        <span
                            >You can clear all demo data by clearing your
                            browser cache</span
                        >
                    </li>
                    <li class="text-gray-700 flex items-start gap-2">
                        <span class="text-blue-600 mt-1">•</span>
                        <span>No data persists beyond your browser session</span
                        >
                    </li>
                    <li class="text-gray-700 flex items-start gap-2">
                        <span class="text-blue-600 mt-1">•</span>
                        <span
                            >No accounts, logins, or personal information are
                            required</span
                        >
                    </li>
                </ul>
            </section>

            <!-- Contact -->
            <section class="mb-8">
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">
                    Questions
                </h2>
                <p class="text-gray-700 leading-relaxed">
                    If you have questions about this Privacy Policy or the demo
                    project, please visit the <a
                        href="/about"
                        class="text-blue-600 hover:underline">About page</a
                    > or <a href="/help" class="text-blue-600 hover:underline"
                        >Help Center</a
                    >.
                </p>
            </section>

            <!-- Footer -->
            <footer class="pt-6 border-t border-gray-200">
                <div class="flex flex-wrap gap-4">
                    <a
                        href="/"
                        class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium"
                    >
                        Back to Home
                    </a>
                    <a
                        href="/terms"
                        class="inline-flex items-center gap-2 px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-100 transition font-medium"
                    >
                        Terms of Service
                    </a>
                </div>
            </footer>
        </article>
    </main>
</Layout>
