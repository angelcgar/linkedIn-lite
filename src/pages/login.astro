---
// No hay autenticación real - esto es solo una demo UX
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Sign in | LinkedIn-lite</title>
        <link rel="stylesheet" href="/src/styles/global.css" />
    </head>
    <body class="bg-neutral-100">
        <div class="min-h-screen flex flex-col">
            <!-- Header -->
            <header class="bg-white border-b border-gray-200 py-4">
                <div class="max-w-md mx-auto px-4">
                    <svg
                        class="w-32 h-8"
                        viewBox="0 0 84 21"
                        fill="currentColor"
                    >
                        <path
                            d="M19.479 0L1.583 0 1.583 18.21 19.479 18.21z"
                            class="text-linkedin-blue"></path>
                        <path
                            d="M82.479 4.907c0-1.022-.19-1.859-.567-2.507-.377-.647-.893-1.177-1.547-1.587-.654-.41-1.409-.711-2.265-.903-.856-.192-1.771-.288-2.745-.288-2.395 0-4.201.549-5.418 1.647-1.217 1.098-1.826 2.748-1.826 4.951v10.779h-5.087V.507h5.087v3.341h.07c.377-.565.823-1.062 1.337-1.491a7.548 7.548 0 011.792-1.062 9.859 9.859 0 012.126-.635A11.04 11.04 0 0176.223 0c3.571 0 6.317.904 8.238 2.712 1.921 1.808 2.882 4.49 2.882 8.044v11.243h-5.087V10.651c0-2.035-.481-3.535-1.443-4.499-.962-.964-2.334-1.446-4.116-1.446-1.782 0-3.179.482-4.19 1.446-1.011.964-1.517 2.464-1.517 4.499v7.348h-5.087V.507h5.087v3.341h.07c.377-.565.823-1.062 1.337-1.491.514-.429 1.098-.786 1.752-1.073a10.21 10.21 0 012.126-.647A11.34 11.34 0 0073.223 0c3.641 0 6.387.904 8.238 2.712 1.851 1.808 2.777 4.49 2.777 8.044v11.243h-1.759V4.907z"
                            class="text-gray-900"></path>
                    </svg>
                </div>
            </header>

            <!-- Main Content -->
            <main class="flex-1 flex items-center justify-center px-4 py-8">
                <div class="bg-white rounded-xl shadow-lg max-w-md w-full p-8">
                    <h1
                        class="text-3xl font-semibold text-gray-900 mb-2 text-center"
                    >
                        Sign in
                    </h1>
                    <p class="text-gray-600 text-center mb-6">
                        Stay updated on your professional world
                    </p>

                    <!-- Login Form -->
                    <form id="login-form" class="space-y-4">
                        <!-- Email Field -->
                        <div>
                            <label
                                for="email"
                                class="block text-sm font-medium text-gray-700 mb-2"
                            >
                                Email or Phone
                            </label>
                            <input
                                type="text"
                                id="email"
                                name="email"
                                value="alex.j@design.com"
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-linkedin-blue focus:border-transparent transition"
                                placeholder="Email or phone"
                                required
                            />
                        </div>

                        <!-- Password Field -->
                        <div>
                            <label
                                for="password"
                                class="block text-sm font-medium text-gray-700 mb-2"
                            >
                                Password
                            </label>
                            <input
                                type="password"
                                id="password"
                                name="password"
                                value="demo123"
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-linkedin-blue focus:border-transparent transition"
                                placeholder="Password"
                                required
                            />
                        </div>

                        <!-- Forgot Password Link -->
                        <div class="text-right">
                            <a
                                href="#"
                                class="text-sm font-semibold text-linkedin-blue hover:text-linkedin-blue-hover transition"
                            >
                                Forgot password?
                            </a>
                        </div>

                        <!-- Submit Button -->
                        <button
                            type="submit"
                            class="w-full bg-linkedin-blue hover:bg-linkedin-blue-hover text-white font-semibold py-3 rounded-full transition shadow-sm"
                        >
                            Sign in
                        </button>
                    </form>

                    <!-- Divider -->
                    <div class="relative my-6">
                        <div class="absolute inset-0 flex items-center">
                            <div class="w-full border-t border-gray-300"></div>
                        </div>
                        <div class="relative flex justify-center text-sm">
                            <span class="px-4 bg-white text-gray-500">or</span>
                        </div>
                    </div>

                    <!-- Demo Note -->
                    <div
                        class="bg-blue-50 border border-blue-200 rounded-lg p-4 text-center"
                    >
                        <p class="text-sm text-blue-800">
                            <strong>Demo Mode:</strong> Click "Sign in" with the pre-filled
                            credentials to continue
                        </p>
                    </div>

                    <!-- Sign Up Link -->
                    <p class="text-center text-sm text-gray-600 mt-6">
                        New to LinkedIn?
                        <a
                            href="#"
                            class="text-linkedin-blue hover:text-linkedin-blue-hover font-semibold transition"
                        >
                            Join now
                        </a>
                    </p>
                </div>
            </main>

            <!-- Footer -->
            <footer class="py-6 text-center">
                <p class="text-xs text-gray-500">
                    © 2026 LinkedIn-lite Demo. Not affiliated with LinkedIn
                    Corporation.
                </p>
            </footer>
        </div>

        <script>
            // Simular login sin autenticación real
            const loginForm = document.getElementById(
                "login-form",
            ) as HTMLFormElement;

            loginForm?.addEventListener("submit", (e) => {
                e.preventDefault();

                // Simular procesamiento
                const submitBtn = loginForm.querySelector(
                    'button[type="submit"]',
                ) as HTMLButtonElement;
                const originalText = submitBtn.textContent;

                submitBtn.disabled = true;
                submitBtn.textContent = "Signing in...";

                // Simular delay de autenticación
                setTimeout(() => {
                    // En una app real, aquí se guardaría el token/sesión
                    // Por ahora solo redirigimos
                    window.location.href = "/";
                }, 800);
            });
        </script>
    </body>
</html>
