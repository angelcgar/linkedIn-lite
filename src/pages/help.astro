---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout>
    <Navbar />

    <main class="max-w-4xl mx-auto px-4 py-12">
        <article class="bg-white rounded-lg shadow-sm p-8">
            <!-- Header -->
            <header class="mb-8 pb-6 border-b border-gray-200">
                <h1 class="text-4xl font-bold text-gray-900 mb-3">
                    Help Center
                </h1>
                <p class="text-lg text-gray-600">
                    Find answers to common questions and learn how to use
                    LinkedIn Lite
                </p>
            </header>

            <!-- Search Bar -->
            <div class="mb-8">
                <div class="relative">
                    <input
                        type="text"
                        placeholder="Search help articles..."
                        class="w-full px-4 py-3 pl-12 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    />
                    <svg
                        class="w-5 h-5 absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                        ></path>
                    </svg>
                </div>
            </div>

            <!-- Quick Links -->
            <section class="mb-8">
                <h2 class="text-xl font-semibold text-gray-900 mb-4">
                    Popular Topics
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <a
                        href="#getting-started"
                        class="p-4 border border-gray-200 rounded-lg hover:border-blue-500 hover:shadow-md transition"
                    >
                        <h3 class="font-semibold text-gray-900 mb-2">
                            Getting Started
                        </h3>
                        <p class="text-sm text-gray-600">
                            Learn the basics of LinkedIn Lite
                        </p>
                    </a>
                    <a
                        href="#account"
                        class="p-4 border border-gray-200 rounded-lg hover:border-blue-500 hover:shadow-md transition"
                    >
                        <h3 class="font-semibold text-gray-900 mb-2">
                            Account Settings
                        </h3>
                        <p class="text-sm text-gray-600">
                            Manage your profile and preferences
                        </p>
                    </a>
                    <a
                        href="#jobs"
                        class="p-4 border border-gray-200 rounded-lg hover:border-blue-500 hover:shadow-md transition"
                    >
                        <h3 class="font-semibold text-gray-900 mb-2">
                            Job Search
                        </h3>
                        <p class="text-sm text-gray-600">
                            Find and apply to job opportunities
                        </p>
                    </a>
                    <a
                        href="#privacy"
                        class="p-4 border border-gray-200 rounded-lg hover:border-blue-500 hover:shadow-md transition"
                    >
                        <h3 class="font-semibold text-gray-900 mb-2">
                            Privacy & Safety
                        </h3>
                        <p class="text-sm text-gray-600">
                            Control your privacy settings
                        </p>
                    </a>
                </div>
            </section>

            <!-- FAQ Section -->
            <section class="mb-8" id="getting-started">
                <h2 class="text-2xl font-semibold text-gray-900 mb-6">
                    Frequently Asked Questions
                </h2>

                <div class="space-y-4">
                    <details
                        class="group p-4 border border-gray-200 rounded-lg"
                    >
                        <summary
                            class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between"
                        >
                            What is LinkedIn Lite?
                            <svg
                                class="w-5 h-5 text-gray-500 transition-transform group-open:rotate-180"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </summary>
                        <p class="mt-3 text-gray-600 text-sm leading-relaxed">
                            LinkedIn Lite is a demo portfolio project that
                            simulates core LinkedIn functionality. It showcases
                            modern web development practices with a focus on
                            clean code and user experience. All data and
                            interactions are simulated and stored locally.
                        </p>
                    </details>

                    <details
                        class="group p-4 border border-gray-200 rounded-lg"
                    >
                        <summary
                            class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between"
                        >
                            How do I create a post?
                            <svg
                                class="w-5 h-5 text-gray-500 transition-transform group-open:rotate-180"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </summary>
                        <p class="mt-3 text-gray-600 text-sm leading-relaxed">
                            Click the "Start a post" button on your home feed.
                            You can write your content, add media, and publish
                            to your network. Posts will appear immediately at
                            the top of your feed.
                        </p>
                    </details>

                    <details
                        class="group p-4 border border-gray-200 rounded-lg"
                        id="jobs"
                    >
                        <summary
                            class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between"
                        >
                            How do I search for jobs?
                            <svg
                                class="w-5 h-5 text-gray-500 transition-transform group-open:rotate-180"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </summary>
                        <p class="mt-3 text-gray-600 text-sm leading-relaxed">
                            Navigate to the Jobs page using the navigation bar.
                            Use the search filters to find opportunities by
                            title, location, job type, and experience level.
                            Click on any job to view details and apply.
                        </p>
                    </details>

                    <details
                        class="group p-4 border border-gray-200 rounded-lg"
                    >
                        <summary
                            class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between"
                        >
                            How do I connect with other users?
                            <svg
                                class="w-5 h-5 text-gray-500 transition-transform group-open:rotate-180"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </summary>
                        <p class="mt-3 text-gray-600 text-sm leading-relaxed">
                            Go to the Network page to see connection suggestions
                            and pending invitations. Click "Connect" on any user
                            profile to send a connection request. Manage your
                            connections from your network dashboard.
                        </p>
                    </details>

                    <details
                        class="group p-4 border border-gray-200 rounded-lg"
                        id="account"
                    >
                        <summary
                            class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between"
                        >
                            How do I edit my profile?
                            <svg
                                class="w-5 h-5 text-gray-500 transition-transform group-open:rotate-180"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </summary>
                        <p class="mt-3 text-gray-600 text-sm leading-relaxed">
                            Click on your profile picture or navigate to the
                            Profile page. You can update your headline, about
                            section, experience, skills, and more. Changes are
                            saved automatically in this demo environment.
                        </p>
                    </details>

                    <details
                        class="group p-4 border border-gray-200 rounded-lg"
                        id="privacy"
                    >
                        <summary
                            class="font-semibold text-gray-900 cursor-pointer flex items-center justify-between"
                        >
                            Is my data secure?
                            <svg
                                class="w-5 h-5 text-gray-500 transition-transform group-open:rotate-180"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </summary>
                        <p class="mt-3 text-gray-600 text-sm leading-relaxed">
                            LinkedIn Lite is a demo application with simulated
                            data. No real user data is collected or stored. All
                            interactions are local to your browser session. For
                            more information, see our Privacy Policy.
                        </p>
                    </details>
                </div>
            </section>

            <!-- Contact Support -->
            <section class="bg-gray-50 rounded-lg p-6">
                <h2 class="text-xl font-semibold text-gray-900 mb-3">
                    Still need help?
                </h2>
                <p class="text-gray-600 mb-4">
                    Cannot find the answer you are looking for? Our support team
                    is here to help.
                </p>
                <div class="flex flex-wrap gap-3">
                    <a
                        href="/"
                        class="inline-flex items-center gap-2 px-5 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium"
                    >
                        Back to Home
                    </a>
                    <a
                        href="/about"
                        class="inline-flex items-center gap-2 px-5 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-100 transition font-medium"
                    >
                        Learn More
                    </a>
                </div>
            </section>
        </article>
    </main>
</Layout>
