---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import ProfileSidebar from "../components/ProfileSidebar.astro";
import RightSidebar from "../components/RightSidebar.astro";
import SearchResults from "../components/SearchResults.astro";

import {
    getCurrentUser,
    getUserSuggestions,
    getPosts,
} from "../lib/api/index.js";

/**
 * SEARCH PAGE (/search)
 * Página dedicada para búsqueda de posts.
 * El query viene del Navbar search input via parámetro "q".
 * Solo carga posts cuando hay un término de búsqueda.
 */

// Obtener query de búsqueda desde URL
const searchQuery = Astro.url.searchParams.get("q") || "";

// Fetch data
const currentUser = await getCurrentUser();
const suggestions = await getUserSuggestions(3);

// Solo buscar si hay query, de lo contrario mostrar estado vacío
const enrichedPosts = searchQuery ? await getPosts(searchQuery) : [];

if (!currentUser) {
    throw new Error("Current user not found");
}
---

<Layout>
    <Navbar />

    <main class="max-w-7xl mx-auto px-4 py-6">
        <div class="grid grid-cols-12 gap-6">
            <!-- Left Sidebar -->
            <aside class="col-span-3">
                <ProfileSidebar user={currentUser} />
            </aside>

            <!-- Main Content -->
            <section class="col-span-6">
                {searchQuery ? (
                    <!-- Resultados de búsqueda -->
                    <SearchResults
                        searchQuery={searchQuery}
                        posts={enrichedPosts}
                    />
                ) : (
                    <!-- Estado inicial cuando no hay búsqueda -->
                    <div class="bg-white rounded-lg shadow p-12 text-center">
                        <svg
                            class="w-20 h-20 mx-auto text-gray-300 mb-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                            ></path>
                        </svg>
                        <h2 class="text-2xl font-bold text-gray-900 mb-2">
                            Search for posts
                        </h2>
                        <p class="text-gray-600 mb-6 max-w-md mx-auto">
                            Use the search bar above to find posts, content, and discussions that interest you.
                        </p>
                        <a
                            href="/"
                            class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"></path>
                            </svg>
                            Go to Feed
                        </a>
                    </div>
                )}
            </section>

            <!-- Right Sidebar -->
            <aside class="col-span-3">
                <RightSidebar suggestions={suggestions} />
            </aside>
        </div>
    </main>
</Layout>
