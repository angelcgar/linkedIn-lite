---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
---

<Layout>
    <Navbar />

    <main class="max-w-4xl mx-auto px-4 py-12">
        <article class="bg-white rounded-lg shadow-sm p-8">
            <!-- Header -->
            <header class="mb-8 pb-6 border-b border-gray-200">
                <h1 class="text-4xl font-bold text-gray-900 mb-3">
                    Terms of Service
                </h1>
                <p class="text-gray-600">Last updated: January 18, 2026</p>
            </header>

            <!-- Introduction -->
            <section class="mb-8">
                <div
                    class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded mb-6"
                >
                    <p class="text-sm text-amber-900 font-medium">
                        Important Notice: LinkedIn Lite is a demonstration
                        portfolio project. These terms describe the demo
                        application only and do not constitute a legally binding
                        agreement.
                    </p>
                </div>
                <p class="text-gray-700 leading-relaxed">
                    By accessing and using LinkedIn Lite, you acknowledge that
                    this is a demonstration project created for portfolio
                    purposes. The application simulates LinkedIn-like features
                    using mock data and does not provide real services.
                </p>
            </section>

            <!-- Acceptance -->
            <section class="mb-8">
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">
                    1. Acceptance of Terms
                </h2>
                <p class="text-gray-700 leading-relaxed mb-4">
                    This demo application is provided "as is" for demonstration
                    and educational purposes. By using LinkedIn Lite, you
                    understand and agree that:
                </p>
                <ul class="space-y-2 ml-6">
                    <li class="text-gray-700">
                        This is a portfolio project, not a real social network
                    </li>
                    <li class="text-gray-700">
                        All data and interactions are simulated
                    </li>
                    <li class="text-gray-700">
                        No real accounts, profiles, or services are provided
                    </li>
                    <li class="text-gray-700">
                        The application is for viewing and testing only
                    </li>
                </ul>
            </section>

            <!-- Demo Nature -->
            <section class="mb-8">
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">
                    2. Demo Application
                </h2>
                <div class="bg-gray-50 rounded-lg p-6 space-y-4">
                    <div>
                        <h3 class="font-semibold text-gray-900 mb-2">
                            No Real Services
                        </h3>
                        <p class="text-gray-700 text-sm leading-relaxed">
                            LinkedIn Lite does not provide actual networking,
                            job search, messaging, or any other professional
                            services. All features are simulated for
                            demonstration purposes only.
                        </p>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-900 mb-2">
                            Mock Data Only
                        </h3>
                        <p class="text-gray-700 text-sm leading-relaxed">
                            All users, posts, jobs, messages, and other content
                            are fictional and generated for demonstration. No
                            real personal information is used or collected.
                        </p>
                    </div>
                    <div>
                        <h3 class="font-semibold text-gray-900 mb-2">
                            No Accounts
                        </h3>
                        <p class="text-gray-700 text-sm leading-relaxed">
                            There is no user registration, authentication, or
                            account management. All interactions are local to
                            your browser session.
                        </p>
                    </div>
                </div>
            </section>

            <!-- Use of Application -->
            <section class="mb-8">
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">
                    3. Permitted Use
                </h2>
                <p class="text-gray-700 leading-relaxed mb-4">
                    You may use LinkedIn Lite to:
                </p>
                <ul class="space-y-2 ml-6">
                    <li class="text-gray-700 flex items-start gap-2">
                        <svg
                            class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                clip-rule="evenodd"></path>
                        </svg>
                        <span>Explore the user interface and features</span>
                    </li>
                    <li class="text-gray-700 flex items-start gap-2">
                        <svg
                            class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                clip-rule="evenodd"></path>
                        </svg>
                        <span>Test the functionality and interactions</span>
                    </li>
                    <li class="text-gray-700 flex items-start gap-2">
                        <svg
                            class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                clip-rule="evenodd"></path>
                        </svg>
                        <span>Review the code and implementation</span>
                    </li>
                    <li class="text-gray-700 flex items-start gap-2">
                        <svg
                            class="w-5 h-5 text-green-500 mt-0.5 flex-shrink-0"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                clip-rule="evenodd"></path>
                        </svg>
                        <span>Learn from the architectural patterns</span>
                    </li>
                </ul>
            </section>

            <!-- Intellectual Property -->
            <section class="mb-8">
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">
                    4. Intellectual Property
                </h2>
                <p class="text-gray-700 leading-relaxed mb-4">
                    LinkedIn Lite is an independent demonstration project:
                </p>
                <ul class="space-y-2 ml-6">
                    <li class="text-gray-700">
                        Not affiliated with, endorsed by, or connected to
                        LinkedIn Corporation
                    </li>
                    <li class="text-gray-700">
                        Created for educational and portfolio purposes
                    </li>
                    <li class="text-gray-700">
                        All mock data and content is original or used under
                        appropriate licenses
                    </li>
                    <li class="text-gray-700">
                        External resources (avatars, images) are used from
                        public services
                    </li>
                </ul>
            </section>

            <!-- Disclaimers -->
            <section class="mb-8">
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">
                    5. Disclaimers
                </h2>
                <div class="bg-gray-50 border border-gray-200 rounded-lg p-6">
                    <p class="text-gray-700 leading-relaxed mb-4">
                        <strong>No Warranties:</strong> The demo application is provided
                        "as is" without warranties of any kind. We make no guarantees
                        about availability, functionality, or performance.
                    </p>
                    <p class="text-gray-700 leading-relaxed mb-4">
                        <strong>No Real Services:</strong> This application does not
                        provide actual networking, job placement, career services,
                        or any professional services of any kind.
                    </p>
                    <p class="text-gray-700 leading-relaxed">
                        <strong>Educational Purpose:</strong> LinkedIn Lite is a technical
                        demonstration created to showcase web development skills and
                        is not intended for commercial use or real-world application.
                    </p>
                </div>
            </section>

            <!-- Limitation of Liability -->
            <section class="mb-8">
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">
                    6. Limitation of Liability
                </h2>
                <p class="text-gray-700 leading-relaxed">
                    The creator of LinkedIn Lite shall not be liable for any
                    damages arising from the use or inability to use this demo
                    application. This includes, but is not limited to, any
                    direct, indirect, incidental, or consequential damages.
                </p>
            </section>

            <!-- Changes to Terms -->
            <section class="mb-8">
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">
                    7. Changes to Terms
                </h2>
                <p class="text-gray-700 leading-relaxed">
                    These terms may be updated at any time to reflect changes to
                    the demo application. Continued use of the application
                    constitutes acceptance of any changes.
                </p>
            </section>

            <!-- Contact -->
            <section class="mb-8">
                <h2 class="text-2xl font-semibold text-gray-900 mb-4">
                    8. Contact
                </h2>
                <p class="text-gray-700 leading-relaxed">
                    For questions about these terms or the demo project, please
                    visit:
                </p>
                <ul class="mt-3 space-y-2 ml-6">
                    <li>
                        <a href="/about" class="text-blue-600 hover:underline"
                            >About Page</a
                        >
                    </li>
                    <li>
                        <a href="/help" class="text-blue-600 hover:underline"
                            >Help Center</a
                        >
                    </li>
                    <li>
                        <a href="/privacy" class="text-blue-600 hover:underline"
                            >Privacy Policy</a
                        >
                    </li>
                </ul>
            </section>

            <!-- Footer -->
            <footer class="pt-6 border-t border-gray-200">
                <div class="flex flex-wrap gap-4">
                    <a
                        href="/"
                        class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition font-medium"
                    >
                        Back to Home
                    </a>
                    <a
                        href="/privacy"
                        class="inline-flex items-center gap-2 px-6 py-3 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-100 transition font-medium"
                    >
                        Privacy Policy
                    </a>
                </div>
            </footer>
        </article>
    </main>
</Layout>
