---
import Layout from "../layouts/Layout.astro";
import { getCurrentUser } from "../lib/api/index.js";

const currentUser = await getCurrentUser();
---

<Layout>
    <div class="min-h-screen bg-gray-50">
        <!-- Header -->
        <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
            <div class="max-w-5xl mx-auto px-4 py-4 flex items-center">
                <a
                    href="/"
                    class="p-2 hover:bg-gray-100 rounded-full transition -ml-2"
                >
                    <svg
                        class="w-6 h-6 text-gray-700"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"
                        ></path>
                    </svg>
                </a>
                <h1
                    class="flex-1 text-xl font-semibold text-gray-900 text-center -ml-10"
                >
                    Settings
                </h1>
            </div>
        </header>

        <main class="max-w-5xl mx-auto px-4 py-6">
            <!-- ACCOUNT Section -->
            <section class="mb-8">
                <h2
                    class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4 px-2"
                >
                    Account
                </h2>
                <div
                    class="bg-white rounded-lg shadow-sm divide-y divide-gray-100"
                >
                    <a
                        href="#"
                        class="flex items-center px-4 py-4 hover:bg-gray-50 transition"
                    >
                        <div
                            class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-6 h-6 text-blue-600"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
                                ></path>
                            </svg>
                        </div>
                        <div class="ml-4 flex-1">
                            <p class="font-semibold text-gray-900">
                                Email Address
                            </p>
                            <p class="text-sm text-gray-500">
                                {currentUser?.email || "alex.j@design.com"}
                            </p>
                        </div>
                        <svg
                            class="w-5 h-5 text-gray-400"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"
                            ></path>
                        </svg>
                    </a>

                    <a
                        href="#"
                        class="flex items-center px-4 py-4 hover:bg-gray-50 transition"
                    >
                        <div
                            class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-6 h-6 text-blue-600"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"
                                ></path>
                            </svg>
                        </div>
                        <div class="ml-4 flex-1">
                            <p class="font-semibold text-gray-900">
                                Phone Number
                            </p>
                        </div>
                        <svg
                            class="w-5 h-5 text-gray-400"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"
                            ></path>
                        </svg>
                    </a>

                    <a
                        href="#"
                        class="flex items-center px-4 py-4 hover:bg-gray-50 transition"
                    >
                        <div
                            class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-6 h-6 text-blue-600"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"
                                ></path>
                            </svg>
                        </div>
                        <div class="ml-4 flex-1">
                            <p class="font-semibold text-gray-900">Password</p>
                        </div>
                        <svg
                            class="w-5 h-5 text-gray-400"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"
                            ></path>
                        </svg>
                    </a>
                </div>
            </section>

            <!-- PRIVACY Section -->
            <section class="mb-8">
                <h2
                    class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4 px-2"
                >
                    Privacy
                </h2>
                <div
                    class="bg-white rounded-lg shadow-sm divide-y divide-gray-100"
                >
                    <a
                        href="#"
                        class="flex items-center px-4 py-4 hover:bg-gray-50 transition"
                    >
                        <div
                            class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-6 h-6 text-blue-600"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"
                                ></path>
                            </svg>
                        </div>
                        <div class="ml-4 flex-1">
                            <p class="font-semibold text-gray-900">
                                Profile Visibility
                            </p>
                            <p class="text-sm text-gray-500">Public</p>
                        </div>
                        <svg
                            class="w-5 h-5 text-gray-400"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"
                            ></path>
                        </svg>
                    </a>

                    <a
                        href="#"
                        class="flex items-center px-4 py-4 hover:bg-gray-50 transition"
                    >
                        <div
                            class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-6 h-6 text-blue-600"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zM4 12c0-4.42 3.58-8 8-8 1.85 0 3.55.63 4.9 1.69L5.69 16.9C4.63 15.55 4 13.85 4 12zm8 8c-1.85 0-3.55-.63-4.9-1.69L18.31 7.1C19.37 8.45 20 10.15 20 12c0 4.42-3.58 8-8 8z"
                                ></path>
                            </svg>
                        </div>
                        <div class="ml-4 flex-1">
                            <p class="font-semibold text-gray-900">
                                Blocked Users
                            </p>
                        </div>
                        <svg
                            class="w-5 h-5 text-gray-400"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"
                            ></path>
                        </svg>
                    </a>

                    <a
                        href="#"
                        class="flex items-center px-4 py-4 hover:bg-gray-50 transition"
                    >
                        <div
                            class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-6 h-6 text-blue-600"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"
                                ></path>
                            </svg>
                        </div>
                        <div class="ml-4 flex-1">
                            <p class="font-semibold text-gray-900">
                                Data Privacy
                            </p>
                        </div>
                        <svg
                            class="w-5 h-5 text-gray-400"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"
                            ></path>
                        </svg>
                    </a>
                </div>
            </section>

            <!-- NOTIFICATIONS Section -->
            <section class="mb-8">
                <h2
                    class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-4 px-2"
                >
                    Notifications
                </h2>
                <div
                    class="bg-white rounded-lg shadow-sm divide-y divide-gray-100"
                >
                    <a
                        href="#"
                        class="flex items-center px-4 py-4 hover:bg-gray-50 transition"
                    >
                        <div
                            class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-6 h-6 text-blue-600"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"
                                ></path>
                            </svg>
                        </div>
                        <div class="ml-4 flex-1">
                            <p class="font-semibold text-gray-900">
                                Push Notifications
                            </p>
                        </div>
                        <svg
                            class="w-5 h-5 text-gray-400"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"
                            ></path>
                        </svg>
                    </a>

                    <a
                        href="#"
                        class="flex items-center px-4 py-4 hover:bg-gray-50 transition"
                    >
                        <div
                            class="w-12 h-12 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                class="w-6 h-6 text-blue-600"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10h5v-2h-5c-4.34 0-8-3.66-8-8s3.66-8 8-8 8 3.66 8 8v1.43c0 .79-.71 1.57-1.5 1.57s-1.5-.78-1.5-1.57V12c0-2.76-2.24-5-5-5s-5 2.24-5 5 2.24 5 5 5c1.38 0 2.64-.56 3.54-1.47.65.89 1.77 1.47 2.96 1.47 1.97 0 3.5-1.6 3.5-3.57V12c0-5.52-4.48-10-10-10zm0 13c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3z"
                                ></path>
                            </svg>
                        </div>
                        <div class="ml-4 flex-1">
                            <p class="font-semibold text-gray-900">
                                Email Notifications
                            </p>
                        </div>
                        <svg
                            class="w-5 h-5 text-gray-400"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"
                            ></path>
                        </svg>
                    </a>
                </div>
            </section>

            <!-- Sign Out Button -->
            <div class="mb-6">
                <button
                    class="w-full bg-red-50 hover:bg-red-100 text-red-600 font-semibold py-4 rounded-lg transition"
                >
                    Sign Out
                </button>
            </div>

            <!-- Version Footer -->
            <div class="text-center text-sm text-gray-400 mb-20">
                LinkedIn-lite Version 1.0.42
            </div>
        </main>

        <!-- Bottom Navigation -->
        <nav
            class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 px-6 py-2"
        >
            <div class="max-w-5xl mx-auto flex items-center justify-around">
                <a
                    href="/"
                    class="flex flex-col items-center py-2 text-gray-600 hover:text-gray-900 transition"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"></path>
                    </svg>
                    <span class="text-xs mt-1">Home</span>
                </a>
                <a
                    href="/network"
                    class="flex flex-col items-center py-2 text-gray-600 hover:text-gray-900 transition"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                        ></path>
                    </svg>
                    <span class="text-xs mt-1">Network</span>
                </a>
                <button class="flex flex-col items-center py-2 -mt-6">
                    <div
                        class="w-14 h-14 bg-blue-600 rounded-full flex items-center justify-center shadow-lg"
                    >
                        <svg
                            class="w-8 h-8 text-white"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                            ></path>
                        </svg>
                    </div>
                </button>
                <a
                    href="/jobs"
                    class="flex flex-col items-center py-2 text-gray-600 hover:text-gray-900 transition"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"
                        ></path>
                    </svg>
                    <span class="text-xs mt-1">Jobs</span>
                </a>
                <a
                    href="/settings"
                    class="flex flex-col items-center py-2 text-blue-600"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                        ></path>
                    </svg>
                    <span class="text-xs mt-1">Settings</span>
                </a>
            </div>
        </nav>
    </div>
</Layout>
