---
import Layout from "../layouts/Layout.astro";
import NotificationItem from "../components/NotificationItem.astro";
import { getNotifications } from "../lib/api/index.js";

const allNotifications = await getNotifications();
const unreadCount = allNotifications.filter((n) => !n.isRead).length;
---

<Layout>
    <div class="min-h-screen bg-gray-50 pb-20">
        <!-- Header -->
        <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
            <div
                class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between"
            >
                <button class="p-2 hover:bg-gray-100 rounded-full transition">
                    <svg
                        class="w-6 h-6 text-gray-700"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                        ></path>
                    </svg>
                </button>

                <h1 class="text-xl font-semibold text-gray-900">
                    Notifications
                </h1>

                <button class="p-2 hover:bg-gray-100 rounded-full transition">
                    <svg
                        class="w-6 h-6 text-gray-700"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"
                        ></path>
                    </svg>
                </button>
            </div>
        </header>

        <main class="max-w-5xl mx-auto">
            <!-- Filter Tabs -->
            <div
                class="bg-white border-b border-gray-200 overflow-x-auto sticky top-[73px] z-40"
            >
                <div
                    class="flex gap-2 px-4 py-3"
                    id="filter-tabs"
                    data-active-filter="all"
                >
                    <button
                        class="px-6 py-2 bg-blue-600 text-white text-sm font-semibold rounded-full whitespace-nowrap transition"
                        data-filter="all"
                    >
                        All
                    </button>
                    <button
                        class="px-6 py-2 bg-gray-100 text-gray-700 text-sm font-semibold rounded-full whitespace-nowrap hover:bg-gray-200 transition"
                        data-filter="posts"
                    >
                        My posts
                    </button>
                    <button
                        class="px-6 py-2 bg-gray-100 text-gray-700 text-sm font-semibold rounded-full whitespace-nowrap hover:bg-gray-200 transition"
                        data-filter="mentions"
                    >
                        Mentions
                    </button>
                    <button
                        class="px-6 py-2 bg-gray-100 text-gray-700 text-sm font-semibold rounded-full whitespace-nowrap hover:bg-gray-200 transition"
                        data-filter="jobs"
                    >
                        Jobs
                    </button>
                </div>
            </div>

            <!-- Notifications List -->
            <div class="divide-y divide-gray-200" id="notifications-list">
                {
                    allNotifications.map((notification) => (
                        <div
                            data-notification-type={notification.type}
                            data-notification-filter={
                                notification.type === "post_like" ||
                                notification.type === "post_comment"
                                    ? "posts"
                                    : notification.type === "mention"
                                      ? "mentions"
                                      : notification.type === "job_alert"
                                        ? "jobs"
                                        : "all"
                            }
                        >
                            <NotificationItem notification={notification} />
                        </div>
                    ))
                }
            </div>

            {
                allNotifications.length === 0 && (
                    <div class="text-center py-12 bg-white">
                        <p class="text-gray-500">No notifications yet.</p>
                    </div>
                )
            }
        </main>

        <!-- Bottom Navigation -->
        <nav
            class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 px-6 py-2"
        >
            <div class="max-w-5xl mx-auto flex items-center justify-around">
                <a
                    href="/"
                    class="flex flex-col items-center py-2 text-gray-600 hover:text-gray-900 transition"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"></path>
                    </svg>
                    <span class="text-xs mt-1">Home</span>
                </a>
                <a
                    href="/network"
                    class="flex flex-col items-center py-2 text-gray-600 hover:text-gray-900 transition"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                        ></path>
                    </svg>
                    <span class="text-xs mt-1">Network</span>
                </a>
                <button class="flex flex-col items-center py-2 -mt-6">
                    <div
                        class="w-14 h-14 bg-blue-600 rounded-full flex items-center justify-center shadow-lg"
                    >
                        <svg
                            class="w-8 h-8 text-white"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                            ></path>
                        </svg>
                    </div>
                </button>
                <a
                    href="/jobs"
                    class="flex flex-col items-center py-2 text-gray-600 hover:text-gray-900 transition"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"
                        ></path>
                    </svg>
                    <span class="text-xs mt-1">Jobs</span>
                </a>
                <a
                    href="/notifications"
                    class="flex flex-col items-center py-2 text-blue-600 relative"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"
                        ></path>
                    </svg>
                    <span class="text-xs mt-1">Alerts</span>
                    {
                        unreadCount > 0 && (
                            <span class="absolute top-1 right-2 w-2 h-2 bg-red-500 rounded-full" />
                        )
                    }
                </a>
            </div>
        </nav>
    </div>
</Layout>

<script>
    const filterTabs = document.getElementById("filter-tabs");
    const notificationsList = document.getElementById("notifications-list");

    if (filterTabs && notificationsList) {
        filterTabs.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            const button = target.closest("[data-filter]") as HTMLButtonElement;

            if (!button) return;

            const filter = button.dataset.filter;

            // Update active tab styling
            filterTabs.querySelectorAll("[data-filter]").forEach((tab) => {
                tab.classList.remove("bg-blue-600", "text-white");
                tab.classList.add(
                    "bg-gray-100",
                    "text-gray-700",
                    "hover:bg-gray-200",
                );
            });

            button.classList.remove(
                "bg-gray-100",
                "text-gray-700",
                "hover:bg-gray-200",
            );
            button.classList.add("bg-blue-600", "text-white");

            // Filter notifications
            const allNotifications = notificationsList.querySelectorAll(
                "[data-notification-filter]",
            );

            allNotifications.forEach((notif) => {
                const notifFilter = (notif as HTMLElement).dataset
                    .notificationFilter;

                if (filter === "all" || notifFilter === filter) {
                    (notif as HTMLElement).style.display = "block";
                } else {
                    (notif as HTMLElement).style.display = "none";
                }
            });
        });
    }
</script>
