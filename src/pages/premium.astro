---
import Layout from "../layouts/Layout.astro";
import { getPremiumFeatures } from "../lib/api/index.js";

const features = await getPremiumFeatures();

const getFeatureIcon = (icon: string) => {
    const icons = {
        eye: `<svg class="w-6 h-6 text-yellow-700" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"></path>
    </svg>`,
        mail: `<svg class="w-6 h-6 text-yellow-700" fill="currentColor" viewBox="0 0 24 24">
      <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"></path>
    </svg>`,
        star: `<svg class="w-6 h-6 text-yellow-700" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"></path>
    </svg>`,
        badge: `<svg class="w-6 h-6 text-yellow-700" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"></path>
    </svg>`,
        learning: `<svg class="w-6 h-6 text-yellow-700" fill="currentColor" viewBox="0 0 24 24">
      <path d="M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82zM12 3L1 9l11 6 9-4.91V17h2V9L12 3z"></path>
    </svg>`,
    };
    return icons[icon as keyof typeof icons] || icons.star;
};
---

<Layout>
    <div class="min-h-screen bg-white pb-20">
        <!-- Header -->
        <header class="bg-white border-b border-gray-200 sticky top-0 z-50">
            <div
                class="max-w-5xl mx-auto px-4 py-4 flex items-center justify-between"
            >
                <a
                    href="/"
                    class="p-2 hover:bg-gray-100 rounded-full transition"
                >
                    <svg
                        class="w-6 h-6 text-gray-700"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"
                        ></path>
                    </svg>
                </a>

                <h1 class="text-xl font-semibold text-gray-900">
                    LinkedIn-lite Premium
                </h1>

                <button class="p-2 hover:bg-gray-100 rounded-full transition">
                    <svg
                        class="w-6 h-6 text-gray-700"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92 1.61 0 2.92-1.31 2.92-2.92s-1.31-2.92-2.92-2.92z"
                        ></path>
                    </svg>
                </button>
            </div>
        </header>

        <main class="max-w-5xl mx-auto px-4 pb-8">
            <!-- Hero Section -->
            <div class="pt-8 pb-12">
                <div
                    class="inline-block px-4 py-1 bg-yellow-500 text-gray-900 text-xs font-bold rounded mb-6"
                >
                    EXCLUSIVE
                </div>

                <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
                    Elevate your career<br />with Premium
                </h2>
            </div>

            <!-- Features Section -->
            <section class="mb-12">
                <h3 class="text-2xl font-bold text-gray-900 mb-6">
                    Exclusive Features
                </h3>

                <div class="space-y-4">
                    {
                        features.map((feature) => (
                            <div class="bg-white border border-gray-200 rounded-xl p-6 shadow-sm hover:shadow-md transition">
                                <div class="flex gap-4">
                                    <div class="w-12 h-12 bg-yellow-100 rounded-xl flex items-center justify-center flex-shrink-0">
                                        <Fragment
                                            set:html={getFeatureIcon(
                                                feature.icon,
                                            )}
                                        />
                                    </div>

                                    <div class="flex-1">
                                        <h4 class="text-lg font-bold text-gray-900 mb-2">
                                            {feature.title}
                                        </h4>
                                        <p class="text-gray-600 text-sm leading-relaxed">
                                            {feature.description}
                                        </p>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </section>

            <!-- Common Questions -->
            <section class="mb-12">
                <h3 class="text-2xl font-bold text-gray-900 mb-6">
                    Common Questions
                </h3>

                <div class="space-y-3">
                    <details class="group">
                        <summary
                            class="flex items-center justify-between bg-white border border-gray-200 rounded-lg p-4 cursor-pointer hover:bg-gray-50 transition"
                        >
                            <span class="text-gray-900 font-semibold"
                                >How does the free trial work?</span
                            >
                            <svg
                                class="w-6 h-6 text-gray-600 transition-transform group-open:rotate-180"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"
                                ></path>
                            </svg>
                        </summary>
                        <div
                            class="mt-2 px-4 py-3 bg-gray-50 rounded-lg text-gray-700 text-sm"
                        >
                            You can start a 1-month free trial and cancel
                            anytime. We'll remind you 7 days before your trial
                            ends.
                        </div>
                    </details>

                    <details class="group">
                        <summary
                            class="flex items-center justify-between bg-white border border-gray-200 rounded-lg p-4 cursor-pointer hover:bg-gray-50 transition"
                        >
                            <span class="text-gray-900 font-semibold"
                                >Can I cancel my subscription?</span
                            >
                            <svg
                                class="w-6 h-6 text-gray-600 transition-transform group-open:rotate-180"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"
                                ></path>
                            </svg>
                        </summary>
                        <div
                            class="mt-2 px-4 py-3 bg-gray-50 rounded-lg text-gray-700 text-sm"
                        >
                            Yes, you can cancel anytime from your account
                            settings. Your Premium features will remain active
                            until the end of your billing period.
                        </div>
                    </details>

                    <details class="group">
                        <summary
                            class="flex items-center justify-between bg-white border border-gray-200 rounded-lg p-4 cursor-pointer hover:bg-gray-50 transition"
                        >
                            <span class="text-gray-900 font-semibold"
                                >What is an InMail credit?</span
                            >
                            <svg
                                class="w-6 h-6 text-gray-600 transition-transform group-open:rotate-180"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"
                                ></path>
                            </svg>
                        </summary>
                        <div
                            class="mt-2 px-4 py-3 bg-gray-50 rounded-lg text-gray-700 text-sm"
                        >
                            InMail credits allow you to send direct messages to
                            people you're not connected with. Premium members
                            get InMail credits monthly.
                        </div>
                    </details>
                </div>
            </section>

            <!-- CTA Button -->
            <div class="text-center">
                <button
                    class="w-full max-w-md bg-yellow-500 hover:bg-yellow-600 text-gray-900 font-bold py-4 px-8 rounded-lg transition shadow-lg"
                >
                    Start 1-month free trial
                </button>
                <p class="text-gray-600 text-sm mt-4">
                    Cancel anytime. We'll remind you 7 days before your trial
                    ends.
                </p>
            </div>
        </main>

        <!-- Bottom Navigation -->
        <nav
            class="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 px-6 py-2"
        >
            <div class="max-w-5xl mx-auto flex items-center justify-around">
                <a
                    href="/"
                    class="flex flex-col items-center py-2 text-gray-600 hover:text-gray-900 transition"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"></path>
                    </svg>
                    <span class="text-xs mt-1">Home</span>
                </a>
                <a
                    href="/network"
                    class="flex flex-col items-center py-2 text-gray-600 hover:text-gray-900 transition"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"
                        ></path>
                    </svg>
                    <span class="text-xs mt-1">Network</span>
                </a>
                <button class="flex flex-col items-center py-2 -mt-6">
                    <div
                        class="w-14 h-14 bg-blue-600 rounded-full flex items-center justify-center shadow-lg"
                    >
                        <svg
                            class="w-8 h-8 text-white"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                            ></path>
                        </svg>
                    </div>
                </button>
                <a
                    href="/jobs"
                    class="flex flex-col items-center py-2 text-gray-600 hover:text-gray-900 transition"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M20 6h-4V4c0-1.11-.89-2-2-2h-4c-1.11 0-2 .89-2 2v2H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-6 0h-4V4h4v2z"
                        ></path>
                    </svg>
                    <span class="text-xs mt-1">Jobs</span>
                </a>
                <a
                    href="/premium"
                    class="flex flex-col items-center py-2 text-yellow-600"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                        ></path>
                    </svg>
                    <span class="text-xs mt-1">Premium</span>
                </a>
            </div>
        </nav>
    </div>
</Layout>
